ELEVENTY_ENV=development

# EdgeX form builder key (copy this file to .env and fill it in; never commit .env)
EDGEX_API_KEY=

# Demo-code service (otp-service/): emails the 6-digit code from info@zennly.io via Resend.
# zennly.io must be verified in Resend (SPF/DKIM records) before RESEND_API_KEY can send from info@zennly.io.
# OTP_SECRET: any long random string (openssl rand -hex 32). Without RESEND_API_KEY locally the code is printed to the service's console.
OTP_SECRET=
RESEND_API_KEY=
# Optional overrides: OTP_FROM, DEMO_LOGIN_EMAIL, DEMO_LOGIN_PASSWORD, DEMO_LOGIN_URL

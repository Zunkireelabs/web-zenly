---
layout: base.njk
title: Booking & Operations Glossary for Service Businesses
metaDescription: "Plain-language booking and operations glossary for spas, salons and clinics: multi-branch, no-show, deposit, reconciliation and more, with regional names."
dateModified: "2026-10-04"
bodyClass: page--light-nav
---
{% from "schema/breadcrumb.njk" import breadcrumbSchema with context %}
{{ breadcrumbSchema([{ name: "Home", url: "/" }, { name: "Glossary", url: "/glossary/" }]) }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": "{{ site.url }}/glossary/#termset",
  "name": "Zennly booking and operations glossary",
  "url": "{{ site.url }}/glossary/",
  "dateModified": "{{ dateModified }}",
  "publisher": { "@id": "{{ site.url }}/#organization" },
  "hasDefinedTerm": [
    {% for t in glossary | sort(false, false, "term") %}{
      "@type": "DefinedTerm",
      "@id": "{{ site.url }}/glossary/#{{ t.slug }}",
      "name": {{ t.term | dump | safe }},
      "alternateName": {{ t.aka.split(", ") | dump | safe }},
      "description": {{ t.definition | dump | safe }},
      "url": "{{ site.url }}/glossary/#{{ t.slug }}",
      "inDefinedTermSet": "{{ site.url }}/glossary/#termset"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<main class="pg-page">

  <section id="v2-glossary"
    x-data='{ q: "", cat: "All", letter: "All", items: [{% for t in glossary %}{ k: {{ t.slug | dump | replace("'", "&#39;") | safe }}, c: {{ t.category | dump | replace("'", "&#39;") | safe }}, l: {{ t.term[0] | upper | dump | safe }}, s: {{ (t.term + ' ' + t.aka + ' ' + t.definition) | lower | dump | replace("'", "&#39;") | safe }} }{% if not loop.last %}, {% endif %}{% endfor %}],
      letters() { return [...new Set(this.items.map(i => i.l))].sort(); },
      ok(k) { const i = this.items.find(x => x.k === k); return (this.cat === "All" || this.cat === i.c) && (this.letter === "All" || this.letter === i.l) && i.s.includes(this.q.toLowerCase().trim()); },
      shown(l) { return this.items.some(i => i.l === l && this.ok(i.k)); },
      count() { return this.items.filter(i => this.ok(i.k)).length; } }'>
    <header class="pg-hero">
      <span class="pg-hero__eyebrow">Glossary</span>
      <h1>Booking &amp; operations <em>glossary.</em></h1>
      <p class="pg-hero__lede">Plain-language definitions of the terms spas, salons, gyms and clinics use when choosing booking software, including the names used in the USA, UK, Canada, Australia, the UAE and Nepal.</p>
      <div class="gl-tools">
        <label for="glossary-search" style="position:absolute; left:-9999px;">Search the glossary</label>
        <div class="gl-search"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input id="glossary-search" class="v2-gloss-search" type="search" x-model="q" placeholder="Search terms, e.g. beauty parlour, cash-up, no-show"></div>
        <div class="v2-gloss-filters" role="group" aria-label="Filter by topic">
          {% for c in ["All", "Booking", "Operations", "Finance", "Security"] %}
          <button type="button" class="v2-gloss-chip" @click="cat = '{{ c }}'" :aria-pressed="cat === '{{ c }}'" :class="{ 'is-on': cat === '{{ c }}' }">{{ c }}</button>
          {% endfor %}
          <span class="v2-gloss-count" x-text="count() + ' of ' + items.length + ' terms'"></span>
        </div>
        <div class="v2-gloss-az" role="group" aria-label="Filter by letter">
          <button type="button" class="v2-gloss-letter" :class="{ 'is-on': letter === 'All' }" @click="letter = 'All'">A&ndash;Z</button>
          <template x-for="l in letters()" :key="l"><button type="button" class="v2-gloss-letter" :class="{ 'is-on': letter === l }" @click="letter = l" x-text="l"></button></template>
        </div>
      </div>
    </header>

    <div class="pg-wrap" style="padding-top:24px; padding-bottom:96px;">
      {% for g in glossary | letterGroups %}
      <div class="gl-group" x-show="shown('{{ g.letter }}')">
        <div class="gl-letter" aria-hidden="true">{{ g.letter }}</div>
        <div class="gl-terms">
          {% for t in g.items %}
          <article class="gl-term" id="{{ t.slug }}" style="scroll-margin-top:120px;" x-show="ok('{{ t.slug }}')">
            <span class="v2-answer__tag">{{ t.category }}</span>
            <h3>{{ t.term }}</h3>
            <p class="gl-aka">Also called: {{ t.aka }}</p>
            <p>{{ t.definition }}</p>
            <a href="{{ t.relatedHref }}" class="gl-link">{{ t.relatedLabel }} &rarr;</a>
          </article>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
      <p class="v2-gloss-empty" x-show="count() === 0" x-cloak>No terms match your search. Try a shorter word or clear the filter.</p>
    </div>
  </section>

  <section class="bottom-cta" id="demo">
    <div class="bottom-cta__card bottom-cta__card--banner reveal">
      <h2 class="bottom-cta__h2">See these ideas in a live system.</h2>
      <p class="bottom-cta__sub">Book a 20-minute demo and we'll show you how Zennly handles them.</p>
      <a href="/demo/" class="bottom-cta__banner-btn">Book your demo &rarr;</a>
    </div>
  </section>

  {% include "_footer-v2.njk" %}

</main>

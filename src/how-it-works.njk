                <span class="hiw-cal__event-label">During the day</span>
                <span class="hiw-cal__event-range">12:00 PM &ndash; 5:00 PM</span>
              </div>
              <p class="hiw-cal__event-text">Staff check their queue. Walk-ins added manually. Rooms auto-assigned. Zero conflicts.</p>
            </div>

            <!-- Row 3: Evening -->
            <div class="hiw-cal__time">5 PM</div>
            <div class="hiw-cal__event hiw-cal__event--evening">
              <div class="hiw-cal__event-hd">
                <span class="hiw-cal__event-icon">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>

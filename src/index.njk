    text-align: left;
    z-index: 2;
    pointer-events: none;
    transform: scale(0);
    opacity: 0;
    transform-origin: top center;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.3s;
  }
  .v2-hero-demo .booking-flow.has-booking .cal-filled-booking {
    transform: scale(1);
    opacity: 1;
  }
  .v2-hero-demo .cal-filled-booking__name {
    font-size: 8.5px;
    font-weight: 700;
    color: #1f2937;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }
  .v2-hero-demo .cal-filled-booking__service {
    font-size: 7.5px;
    color: #4b5563;
    margin-top: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;

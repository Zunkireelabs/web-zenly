    /* ── HERO PHONE IMAGE ─────────────────────────────────── */
    /* Video + cycling cards sit behind the frame image, aligned to its real transparent
       screen cutout. Measured from the source PNG (780x1598): screen spans x 38-745, y 31-1566. */

    .v2-hero-demo .hero__phone {
      position: relative;
      justify-self: center;
      width: 100%;
      max-width: 400px;
      margin-top: 48px;
    }

    .v2-hero-demo .hero__phone::before {
      content: "";
      position: absolute;
      top: -12%;
      left: -12%;
      right: -12%;
      bottom: -12%;
      background: radial-gradient(circle, rgba(194, 237, 206, 0.9) 0%, rgba(194, 237, 206, 0) 70%);
      filter: blur(48px);
      z-index: 0;
      pointer-events: none;
      /* Compensates for the parent .hero__phone's own scroll-driven translate
         (see main.js) so the glow reads as a slower background layer instead
         of moving in lockstep with the phone. */
      transform: translateY(var(--hero-glow-shift, 0px));
    }

    .v2-hero-demo .hero__phone-frame {
      position: relative;
      z-index: 2;
      display: block;
      width: 100%;
      height: auto;
      pointer-events: none;
    }

    .v2-hero-demo .hero__phone-media {
      position: absolute;
      z-index: 1;
      top: 1.94%;
      left: 4.87%;
      right: 4.49%;
      bottom: 2%;
      border-radius: 38px;
      overflow: hidden;
      background-color: #0d1c0b;
    }

    /* ── iOS Status Bar & Dynamic Island Style ─────────── */

    .v2-hero-demo .phone-status-bar {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 48px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 24px;
      z-index: 10;
      pointer-events: none;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #000000;
    }

    .v2-hero-demo .phone-status-bar__time {
      font-size: 13.5px;
      font-weight: 600;
      letter-spacing: -0.1px;
      width: 60px;
      text-align: left;
      user-select: none;

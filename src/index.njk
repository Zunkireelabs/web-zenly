  .v2-site-footer{position:relative; padding:136px 32px 0; border-top-left-radius:var(--v2-flow-radius); border-top-right-radius:var(--v2-flow-radius); background:var(--v2-bg-alt); box-shadow:0 calc(-1 * var(--v2-flow-radius)) 0 0 var(--v2-link);}
  .v2-footer-content{max-width:1180px; margin:0 auto; padding-bottom:80px; display:flex; flex-direction:column; gap:60px;}
  .v2-footer-top{display:flex; gap:64px; justify-content:space-between;}
  .v2-footer-brand{display:flex; flex-direction:column; align-items:flex-start; gap:16px; max-width:264px; flex-shrink:0;}
  .v2-footer-logo{font-family:var(--v2-sans); font-weight:700; font-size:22px; letter-spacing:-0.02em; color:var(--v2-link); text-decoration:none;}
  .v2-footer-tagline{font-size:16px; line-height:1.5; letter-spacing:-0.01em; color:var(--v2-ink-soft); margin:0;}
  .v2-footer-status{display:flex; align-items:center; gap:8px; font-size:14px; letter-spacing:-0.01em; color:var(--v2-ink-soft);}
  .v2-live-dot{display:inline-block; width:8px; height:8px; border-radius:50%; background:#22c55e; flex-shrink:0;}
  .v2-footer-links{display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:72px 56px; flex:1 1 auto;}
  .v2-footer-link-group{display:flex; flex-direction:column; align-items:flex-start; gap:16px;}
  .v2-footer-heading{font-family:var(--v2-serif); font-style:italic; font-weight:400; font-size:26px; line-height:1.34; letter-spacing:-0.02em; color:var(--v2-link); margin:0; white-space:nowrap;}
  .v2-footer-link{font-size:20px; line-height:1.3; letter-spacing:-0.02em; font-weight:500; color:var(--v2-ink); white-space:nowrap;}
  .v2-footer-link:hover{opacity:.72;}
  .v2-footer-copyright{font-size:16px; line-height:1.1; letter-spacing:-0.02em; color:var(--v2-ink);}

  @media (max-width:860px){
    .v2-works-grid{grid-template-columns:1fr;}
    .v2-benefits-grid{grid-template-columns:1fr 1fr;}
    .v2-works-steps{position:static;}
    .v2-nav__links{display:none;}
    .v2-access{padding:96px 0;}
    .v2-access-inner{gap:56px;}
    .v2-access-copy{gap:24px;}
    .v2-access-title{font-size:clamp(34px,9vw,44px); line-height:1.08;}
    .v2-access-form{min-height:76px; padding-block:16px;}
    .v2-access-form input{font-size:17px;}
    /* Bleed past .v2-wrap's 32px gutter (edge-to-edge) so the mockup below
       has the full viewport width to grow into instead of being capped by
       the reserved 280px box — it was rendering at 296px already (0.38
       scale), narrower than even that box, and easy to miss/misread. */
    .v2-access-gallery{height:320px; max-width:none; margin-inline:-32px;}
    /* calc(88vw / 780px) gives a unitless scale factor, so the mockup's
       rendered width is always ~88% of the viewport (not a fixed px scale
       that's oversized on a 375px phone and undersized on a 430px one). */
    .v2-access-gallery__phone{--v2-hero-demo-scale:calc(88vw / 780px); width:calc(780px * var(--v2-hero-demo-scale)); height:calc(1598px * var(--v2-hero-demo-scale));}
    .v2-access-card{display:none;}
    /* 32px side padding (not the old 16px) to match every other section's
       mobile gutter. */
    .v2-site-footer{padding:80px 32px 0;}
    .v2-footer-content{gap:48px; padding-bottom:56px;}
    .v2-footer-top{flex-direction:column; gap:40px;}
    .v2-footer-brand{max-width:none;}
    .v2-footer-links{grid-template-columns:1fr 1fr; gap:48px 16px;}
    .v2-footer-link-group{gap:12px;}
    .v2-footer-heading{font-size:23px; white-space:normal;}
    .v2-footer-link{font-size:17px; white-space:normal;}
    .v2-footer-copyright{font-size:14px;}
  }

  /* COMPARISON — mobile: stacked crossfade (bad underneath, good wipes in on
     top as the section scrolls through view), ported 1:1 from getflect.app's
     @media(max-width:767px) comparison rules. */
  @media (max-width:767px){
    .v2-comparison-stage{min-height:720px;}
    .v2-comparison-title{font-size:32px;}
    .v2-comparison-bubble{min-height:62px; padding:18px 20px; font-size:16px;}
    .v2-comparison-bubble--good svg{width:20px; height:20px; flex-basis:20px;}

    .v2-comparison{border-radius:var(--v2-r-lg); height:auto; min-height:0; overflow:hidden; border:0; padding:0;}
    .v2-comparison-stage{
      --v2-cmp-list-top:clamp(144px,37vw,168px);
      --v2-cmp-row-gap:clamp(78px,20vw,88px);
      position:relative; display:block;
      min-height:calc(var(--v2-cmp-list-top) + (var(--v2-cmp-row-gap) * 4) + 168px);
      height:auto; padding:0 8px; gap:0; overflow:hidden; border-radius:var(--v2-r-lg);
      background:var(--v2-bg); contain:layout;
    }
    .v2-comparison-side{position:absolute; inset:0; min-height:0; overflow:hidden; border-radius:inherit;}
    .v2-comparison-side--bad, .v2-comparison-side--good{min-height:0; padding:0;}
    .v2-comparison-side--bad{
      z-index:1;
      background:radial-gradient(ellipse 84% 54% at 50% 56%, rgba(46,25,25,0.13) 0%, rgba(46,25,25,0.09) 48%, rgba(255,255,255,0.70) 100%), var(--v2-bg);
    }
    .v2-comparison-side--bad::after{
      inset:0; width:100%;
      background:radial-gradient(ellipse 76% 52% at 50% 56%, rgba(46,25,25,0.05) 0%, rgba(255,255,255,0.36) 100%);
    }
    .v2-comparison-side--good{
      z-index:3; opacity:0;
      background:radial-gradient(ellipse 88% 62% at 50% 52%, #f5efb7 0%, #ebeca1 24%, #dff2af 44%, #edf6dc 64%, #ffffff 100%), var(--v2-bg);
      transition:opacity .62s var(--v2-ease-out); will-change:opacity;
    }
    .v2-comparison-stage.is-good-ready .v2-comparison-side--good{opacity:1;}
    .v2-comparison-side--good .v2-comparison-title{
      opacity:0; filter:blur(4px); transform:none;
      transition:opacity .62s var(--v2-ease-out), filter .68s var(--v2-ease-luxe);
      transition-delay:.08s;
    }
    .v2-comparison-divider{display:none;}
    .v2-comparison-title{
      position:absolute; top:clamp(68px,18vw,84px); left:0; right:auto; width:100%; margin-bottom:0;
      font-size:clamp(34px,9vw,44px); line-height:1.08; text-align:center;
    }
    .v2-comparison-title--bad{opacity:.7; right:auto;}
    .v2-comparison-title--good{left:0; transform:none;}
    .v2-comparison-bubble{
      min-height:0; padding:10px 11px; border-radius:24px; font-size:clamp(15px,4.1vw,17px);
      line-height:1.16; white-space:normal; text-align:left;
    }
    .v2-comparison-bubble--bad, .v2-comparison-bubble--good, .v2-comparison-bubble--good-wide{
      top:var(--mobile-y); left:50%; right:auto; width:max-content; max-width:calc(100% - 16px);
      min-height:56px; padding:14px 16px; border-radius:34px; justify-content:flex-start;
      transform:translate3d(-50%,0,0);
    }
    .v2-comparison-bubble--good{
      opacity:0; filter:blur(4px); width:max-content; max-width:none; justify-content:center;
      white-space:nowrap; text-align:center; transform:translate3d(-50%,0,0);
      transition:opacity .62s var(--v2-ease-out), filter .68s var(--v2-ease-luxe);
      transition-delay:calc(.12s + var(--d,0s) * .45);
    }
    .v2-comparison-side--bad .v2-comparison-bubble:nth-of-type(1),
    .v2-comparison-good-list .v2-comparison-bubble:nth-child(1){--mobile-y:var(--v2-cmp-list-top);}
    .v2-comparison-side--bad .v2-comparison-bubble:nth-of-type(2),
    .v2-comparison-good-list .v2-comparison-bubble:nth-child(2){--mobile-y:calc(var(--v2-cmp-list-top) + var(--v2-cmp-row-gap));}
    .v2-comparison-side--bad .v2-comparison-bubble:nth-of-type(3),
    .v2-comparison-good-list .v2-comparison-bubble:nth-child(3){--mobile-y:calc(var(--v2-cmp-list-top) + (var(--v2-cmp-row-gap) * 2));}
    .v2-comparison-side--bad .v2-comparison-bubble:nth-of-type(4),
    .v2-comparison-good-list .v2-comparison-bubble:nth-child(4){--mobile-y:calc(var(--v2-cmp-list-top) + (var(--v2-cmp-row-gap) * 3));}
    .v2-comparison-side--bad .v2-comparison-bubble:nth-of-type(5),
    .v2-comparison-good-list .v2-comparison-bubble:nth-child(5){--mobile-y:calc(var(--v2-cmp-list-top) + (var(--v2-cmp-row-gap) * 4));}
    .v2-comparison-good-list{position:absolute; inset:0; display:block;}
    .v2-comparison-stage.is-good-ready .v2-comparison-title--good{opacity:1; filter:blur(0); transform:none;}
    .v2-comparison-stage.is-good-ready .v2-comparison-bubble--good{opacity:1; filter:blur(0); transform:translate3d(-50%,0,0);}
    .v2-comparison-good-cover{display:none;}
    .v2-comparison-bubble--good svg{display:none;}
  }
</style>

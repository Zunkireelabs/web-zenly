---
layout: base.njk
title: Zenly — Online Booking & Operations Platform
---

<main>

  <!-- ── HERO ─────────────────────────────────────────── -->
  <section class="hero" id="hero">

    <video class="hero__video" autoplay muted loop playsinline>
      <source src="/assets/videos/hero.mp4" type="video/mp4">
    </video>
    <div class="hero__overlay"></div>

    <div class="hero__inner">

      <!-- Left: text -->
      <div class="hero__text">
        <h1 class="hero__headline">
          Running multiple branches shouldn't feel like a second job.
        </h1>
        <div class="hero__actions">
          <a href="#demo" class="btn-hero-primary">Book a 20-minute demo →</a>
          <a href="/how-it-works" class="btn-hero-ghost">See how it works</a>
        </div>
      </div>

      <!-- Right: cycling glass feature elements -->
      <div class="hero__ui">

        <!-- 1. New booking notification -->
        <div class="hero-feature" data-feature="0">
          <div class="hero-feature__icon">🔔</div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">New Booking Received</div>
            <div class="hero-feature__sub">Thai Massage · Tomorrow 10:30 AM · Nuad Thai Spa</div>
          </div>
        </div>

        <!-- 2. Staff transfer -->
        <div class="hero-feature hero-feature--left" data-feature="1">
          <div class="hero-feature__icon">↗</div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">Priya T. · Transferred</div>
            <div class="hero-feature__sub">Branch 3 · Effective Mon</div>
          </div>
        </div>

        <!-- 3. Discount approval -->
        <div class="hero-feature" data-feature="2">
          <div class="hero-feature__dot hero-feature__dot--amber"></div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">Discount Requested</div>
            <div class="hero-feature__sub">15% · Awaiting approval</div>
          </div>
        </div>

        <!-- 4. Booking confirmed -->
        <div class="hero-feature hero-feature--confirmed hero-feature--left" data-feature="3">
          <div class="hero-feature__dot hero-feature__dot--green"></div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">Booking Confirmed</div>
            <div class="hero-feature__sub">Thai Massage · 60 min · #ZNL-00194</div>
          </div>
        </div>

        <!-- 5. Branch overview -->
        <div class="hero-feature" data-feature="4">
          <div class="hero-feature__dots">
            <span class="hero-feature__dot hero-feature__dot--green"></span>
            <span class="hero-feature__dot hero-feature__dot--green"></span>
            <span class="hero-feature__dot hero-feature__dot--green"></span>
          </div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">Branch 2 · Live</div>
            <div class="hero-feature__sub">8 bookings today · 2 in progress</div>
          </div>
        </div>

        <!-- 6. Daily close -->
        <div class="hero-feature hero-feature--left" data-feature="5">
          <div class="hero-feature__icon">✓</div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">Day Closed</div>
            <div class="hero-feature__sub">₨47,200 reconciled · 23 bookings</div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- ── TRUST BAND ─────────────────────────────────────── -->
  <section class="trust-band">
    <div class="trust-band__inner">

      <h2 class="trust-band__heading reveal"><span class="trust-band__phrase" data-phrase="1">Service businesses</span> <span class="trust-band__phrase" data-phrase="2">that run on Zenly.</span></h2>

      <div class="trust-band__grid reveal" data-delay="1">

        <!-- Row 1 -->
        <div class="trust-chip trust-chip--live">Nuad Thai Spa</div>
        <div class="trust-chip trust-chip--light-italic">Pure Glow</div>
        <div class="trust-chip trust-chip--caps">The Curl Studio</div>
        <div class="trust-chip trust-chip--medium">SmileWell</div>
        <div class="trust-chip trust-chip--bold">FitForm</div>

        <!-- Row 2 -->
        <div class="trust-chip trust-chip--dot">revive.</div>
        <div class="trust-chip trust-chip--medium">Ink &amp; Canvas</div>
        <div class="trust-chip trust-chip--wide-caps">PHYSIO PLUS</div>
        <div class="trust-chip trust-chip--dot">clean &amp; co.</div>
        <div class="trust-chip trust-chip--serif-italic">nail atelier</div>

        <!-- Row 3 -->
        <div class="trust-chip trust-chip--caps">ZENITH DENTAL</div>
        <div class="trust-chip trust-chip--serif">maven</div>
        <div class="trust-chip trust-chip--heavy">FLEX</div>
        <div class="trust-chip trust-chip--medium">The Tidiers</div>
        <div class="trust-chip trust-chip--light-italic">bloom studio</div>

      </div>

    </div>
  </section>


  <!-- ── STORYTELLING VIEWPORT OVERLAP ──────────────────────── -->
  <section class="storytelling-section" id="storytellingSection">
    <div class="storytelling-inner" id="storytellingInner">

      <!-- Slide 1: Problem -->
      <div class="story-slide story-slide--problem" id="storySlideProblem">
        <p class="problem__body" id="problemBody">
          You're not running a business anymore. <strong>You're putting out fires.</strong> <span class="pw-hover">Bookings</span>
          <span class="pain-badge pain-badge--amber">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
          </span>
          <strong>lost in WhatsApp,</strong> revenue you <strong>can't reconcile,</strong> discounts
          <span class="pain-badge pain-badge--indigo">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
          </span>
          <strong>handed out without approval</strong> — every day starts with
          <span class="pain-badge pain-badge--rose">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </span>
          <strong>confusion</strong> and ends with guesswork.
        </p>
      </div>

      <!-- Slide 2: Solution Header & Divider -->
      <div class="story-slide story-slide--solution" id="storySlideSolution">
        <div class="story-divider-container" id="storyDividerContainer">
          <div class="story-divider-line story-divider-line--left"></div>
          <span class="story-divider-label">THE TURN</span>
          <div class="story-divider-line story-divider-line--right"></div>
        </div>

        <div class="solution__header" id="solutionHeader">
          <h2 class="solution__headline">
            <span class="sol-phrase" data-phrase="1">One system</span>
            <span class="sol-phrase" data-phrase="2">Every branch</span>
            <span class="sol-phrase" data-phrase="3">Full control,</span>
            <span class="sol-phrase" data-phrase="4">finally</span>
          </h2>
          <p class="solution__sub">Not another tool to learn. A platform built around how your business actually runs.</p>
        </div>
      </div>

    </div>
  </section>


  .v2-access-gallery__phone{
    position:absolute; top:95%; left:50%; transform:translate3d(-50%,-50%,0); z-index:2;
    --v2-hero-demo-scale:0.72;
    width:calc(780px * var(--v2-hero-demo-scale)); height:calc(1598px * var(--v2-hero-demo-scale));
    filter:drop-shadow(0 30px 50px rgba(10,14,4,0.45));

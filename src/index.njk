  /* ── HERO PHONE IMAGE ─────────────────────────────────── */
  /* Video + cycling cards sit behind the frame image, aligned to its real transparent
     screen cutout. Measured from the source PNG (780x1598): screen spans x 38-745, y 31-1566. */

  .v2-hero-demo .hero__phone {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 400px;
    margin-top: 48px;
  }

  .v2-hero-demo .hero__phone::before {
    content: "";
    position: absolute;
    top: -12%;
    left: -12%;
    right: -12%;
    bottom: -12%;
    background: radial-gradient(circle, rgba(194, 237, 206, 0.9) 0%, rgba(194, 237, 206, 0) 70%);
    filter: blur(48px);
    z-index: 0;
    pointer-events: none;
    /* Compensates for the parent .hero__phone's own scroll-driven translate
       (see main.js) so the glow reads as a slower background layer instead
       of moving in lockstep with the phone. */
    transform: translateY(var(--hero-glow-shift, 0px));
  }


  .v2-hero-demo .hero__phone-frame {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .v2-hero-demo .hero__phone-media {
    position: absolute;
    z-index: 1;
    top: 1.94%;
    left: 4.87%;
    right: 4.49%;
    bottom: 2%;
    border-radius: 38px;
    overflow: hidden;
    background-color: #0d1c0b;
  }

  .v2-hero-demo .hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(20px);
  }

  .v2-hero-demo .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 18, 6, 0.10) 0%,

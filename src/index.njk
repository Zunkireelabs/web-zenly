layout: base.njk
title: Zenly — Online Booking & Operations Platform
---

<main>

  <!-- ── HERO ─────────────────────────────────────────── -->
  <section class="hero" id="hero">

    <video class="hero__video" autoplay muted loop playsinline>
      <source src="/assets/videos/hero.mp4" type="video/mp4">
    </video>
    <div class="hero__overlay"></div>

    <div class="hero__inner">

      <!-- Left: text -->
      <div class="hero__text">
        <h1 class="hero__headline">
          The booking platform service businesses run on.
        </h1>
        <div class="hero__actions">
          <a href="#demo" class="btn-hero-primary">Book a Demo</a>
        </div>
      </div>

      <!-- Right: cycling glass feature elements -->
      <div class="hero__ui">

        <!-- 1. New booking notification -->
        <div class="hero-feature" data-feature="0">
          <div class="hero-feature__icon">🔔</div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">New Booking Received</div>
            <div class="hero-feature__sub">Thai Massage · Tomorrow 10:30 AM · Nuad Thai Spa</div>
          </div>
        </div>

        <!-- 2. Time slot picker -->
        <div class="hero-feature hero-feature--slots hero-feature--left" data-feature="1">
          <div class="hero-feature__date">Thu, Jun 12</div>
          <div class="hero-feature__slots">
            <span class="slot">09:00</span>
            <span class="slot slot--active">10:30</span>
            <span class="slot">02:00</span>
            <span class="slot">03:30</span>
          </div>
        </div>

        <!-- 3. Therapist available -->
        <div class="hero-feature" data-feature="2">
          <div class="hero-feature__dot hero-feature__dot--green"></div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">Maya S. · Available</div>
            <div class="hero-feature__sub">Room 4 · Free</div>
          </div>
        </div>

        <!-- 4. Booking confirmed -->
        <div class="hero-feature hero-feature--confirmed hero-feature--left" data-feature="3">
          <div class="hero-feature__dot hero-feature__dot--green"></div>
          <div class="hero-feature__body">
            <div class="hero-feature__title">Booking Confirmed</div>
            <div class="hero-feature__sub">Thai Massage · 60 min · #ZNL-00194</div>
          </div>
        </div>

        <!-- 5. Staff status -->
        <div class="hero-feature" data-feature="4">
          <div class="hero-feature__dots">
            <span class="hero-feature__dot hero-feature__dot--green"></span>
            <span class="hero-feature__dot hero-feature__dot--green"></span>
            <span class="hero-feature__dot hero-feature__dot--green"></span>
          </div>

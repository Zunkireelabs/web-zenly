      <button class="v2-tab" role="tab" id="v2-tab-close" aria-controls="v2-ocpanel-close" aria-selected="false" tabindex="-1">Faster daily close<i></i></button>
      <button class="v2-tab" role="tab" id="v2-tab-discounts" aria-controls="v2-ocpanel-discounts" aria-selected="false" tabindex="-1">Discount control<i></i></button>
    </div>
    <div class="v2-ocpanels v2-reveal">
      <div class="v2-ocpanel is-active" role="tabpanel" id="v2-ocpanel-bookings" aria-labelledby="v2-tab-bookings">
        <div><p class="v2-ocpanel__eyebrow">Online booking</p><h3>Customers book in under a minute, any time of day.</h3><p>Your own booking page and app: clients pick a branch, service, staff member and time, then get a booking number. No calls, no back-and-forth.</p><div class="v2-ocpanel__instead">Instead of <span>Phone calls</span><span>WhatsApp confirmations</span><span>Missed messages</span></div></div>
        <div class="v2-ocpanel__visual">{% image "/assets/images/feat-idx-self-booking.png", "A customer booking a massage on her phone", { loading: "lazy", sizes: "(max-width: 980px) 90vw, 640px" } %}</div>

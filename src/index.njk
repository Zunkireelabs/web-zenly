  <!-- ── SECTION 5: EVERYTHING YOU NEED ───────────────────────────────── -->
  <section class="section" id="features">
    <div class="section__inner">

      <div class="entr-header" id="entrHeader">
        <h2 class="entr-headline">
          <span class="entr-phrase" data-phrase="1">Everything you need</span>
          <span class="entr-phrase" data-phrase="2">to run your business</span>
        </h2>
        <p class="section__sub entr-header__sub">Booking, operations, and finance — built for service businesses.</p>
      </div>

      <div class="entr-list">

        <!-- Row 1: Booking — feat card -->
        <div class="feat-card feat-card--sm">
          <div class="feat-card__inner">
            <div class="feat-card__text">
              <h3 class="entr-row__h3" style="white-space:nowrap;">Customers self-book, 24/7.</h3>
              <p class="entr-row__sub">Set up your services once. Customers pick a slot, choose their staff, and get an instant confirmation. No calls. No WhatsApp back-and-forth. No double-bookings — ever.</p>
              <a href="/features#booking" class="btn-feat">Explore →</a>
            </div>
            <div class="feat-card__visual">
              <img src="/assets/images/card1-booking.png" alt="Customer self-booking on phone" class="feat-card__photo">
            </div>
          </div>
        </div>

        <!-- Rows 4 & 5: 1/3 + 2/3 -->
        <div class="feat-grid feat-grid--large-last">

          <!-- Card 4: Reports -->
          <div class="feat-card feat-card--stack" data-delay="1">
            <div class="feat-card__top rpt-img-top">
              <img src="/assets/images/reports-cluster.png" alt="Reports cluster" class="rpt-cluster-img">
            </div>
            <div class="feat-card__bottom">
              <h3 class="entr-row__h3">Every insight, on demand.</h3>
              <p class="entr-row__sub">Revenue, attendance, performance — filtered, exportable, always current.</p>
              <a href="/features#reports" class="btn-feat">Explore →</a>
            </div>
          </div>

          <!-- Card 2: Operations -->
          <div class="feat-card feat-card--stack" data-delay="2">
            <div class="feat-card__top">
              <div class="scard-scene">
                <div class="scard scard--back scard--left">
                  <p class="scard__label">Staff View</p>
                  <div class="scard__bar scard__bar--lg"></div>
                  <div class="scard__grid">
                    <div class="scard__cell"></div>
                    <div class="scard__cell scard__cell--dim"></div>
                    <div class="scard__cell"></div>
                    <div class="scard__cell scard__cell--dim"></div>
                  </div>
                  <div class="scard__bar scard__bar--sm"></div>
                </div>
                <div class="scard scard--front">
                  <div class="scard__badge">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  <p class="scard__label">Admin Dashboard</p>
                  <div class="scard__bar scard__bar--lg"></div>
                  <div class="scard__grid">
                    <div class="scard__cell"></div>
                    <div class="scard__cell"></div>
                    <div class="scard__cell"></div>
                    <div class="scard__cell"></div>
                    <div class="scard__cell"></div>
                    <div class="scard__cell"></div>
                    <div class="scard__cell scard__cell--dim"></div>
                    <div class="scard__cell scard__cell--dim"></div>
                  </div>
                  <div class="scard__bar"></div>
                  <div class="scard__bar scard__bar--sm"></div>
                </div>
                <div class="scard scard--back scard--right">
                  <p class="scard__label">Manager View</p>
                  <div class="scard__bar scard__bar--lg"></div>
                  <div class="scard__grid">
                    <div class="scard__cell"></div>
                    <div class="scard__cell scard__cell--dim"></div>
                    <div class="scard__cell"></div>
                    <div class="scard__cell scard__cell--dim"></div>
                  </div>
                  <div class="scard__bar scard__bar--sm"></div>
                </div>
              </div>
            </div>
            <div class="feat-card__bottom">
              <h3 class="entr-row__h3">Every booking. One screen.</h3>
              <p class="entr-row__sub">Staff, managers, and admins each see exactly what they need. No chasing updates.</p>
              <a href="/features#operations" class="btn-feat">Explore →</a>
            </div>
          </div>

        </div>

        <!-- Row 3: Zero Conflicts — full width, side-by-side -->
        <div class="feat-card feat-card--sm" style="grid-template-columns: 1fr 1fr;">
          <div class="feat-card__inner">
            <div class="feat-card__text">
              <h3 class="entr-row__h3">Zero double-bookings.</h3>
              <p class="entr-row__sub">Checks staff, room, and duration. Can't fit — it won't book.</p>
              <a href="/features#booking" class="btn-feat">Explore →</a>
            </div>
            <div class="feat-card__visual c2-visual">
              <button class="c2-bell-btn" id="c2Bell" aria-label="Show notifications">
                <div class="c2-bell-pulse"></div>
                <svg class="c2-bell-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                <span class="c2-bell-badge">3</span>
              </button>
              <div class="c2-panel" id="c2Panel">
                <div class="c2-panel__header">
                  <span class="c2-panel__title">Notifications</span>
                  <span class="c2-panel__count">3 new</span>
                </div>
                <div class="c2-panel__item c2-panel__item--blocked">
                  <div class="c2-panel__icon">✕</div>
                  <div class="c2-panel__body">
                    <div class="c2-panel__text">Conflict blocked</div>
                    <div class="c2-panel__time">10:30 AM · already booked</div>
                  </div>
                </div>
                <div class="c2-panel__item c2-panel__item--ok">
                  <div class="c2-panel__icon">✓</div>
                  <div class="c2-panel__body">
                    <div class="c2-panel__text">Booking confirmed</div>
                    <div class="c2-panel__time">Sarah K. · no overlap</div>
                  </div>
                </div>
                <div class="c2-panel__item c2-panel__item--ok">
                  <div class="c2-panel__icon">✓</div>
                  <div class="c2-panel__body">
                    <div class="c2-panel__text">Room auto-assigned</div>
                    <div class="c2-panel__time">60 min · no conflict</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div><!-- /.entr-list -->
    </div>
  </section>

  </div><!-- /.reveal-wrap -->

  <!-- ── TRANSFORMATION — BEFORE / AFTER ─────────────────────────────── -->
  <section class="section" id="transformation">
    <div class="section__inner">

      <div class="redline-header reveal">
        <h2 class="section__h2"><span class="hl-phrase" data-phrase="1">This is what changes</span> <span class="hl-phrase" data-phrase="2">on one system.</span></h2>
        <p class="section__sub">Same day-to-day work, six fewer headaches.</p>
      </div>

      <div class="compare-card reveal-scale" data-delay="1">

        <div class="compare-card__header compare-card__header--problem">
          <span class="compare-card__icon compare-card__icon--problem" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </span>
          <h3 class="compare-card__heading">Sound familiar?</h3>
        </div>

        <div class="compare-card__header compare-card__header--solution">
          <span class="compare-card__icon compare-card__icon--solution" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          </span>
          <h3 class="compare-card__heading">Zenly does this.</h3>

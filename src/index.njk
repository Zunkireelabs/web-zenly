    .v2-hero-demo .booking-drawer-back,.v2-hero-demo  .booking-drawer-close {
      font-size: 16px;
      color: #9ca3af;
      cursor: pointer;
      width: 24px;
      display: flex;
      align-items: center;
    }
    .v2-hero-demo .booking-drawer-back {
      color: #4b5563;
    }
    .v2-hero-demo .booking-drawer-close {
      justify-content: flex-end;
      font-size: 20px;
      line-height: 1;
    }
    .v2-hero-demo .booking-drawer-content {
      flex: 1;
      overflow-y: auto;
      padding: 12px 14px;
    }

    /* Time/Review drawer classes */

    @media (max-width: 900px) {
      .v2-hero-demo .hero__phone {
        max-width: 320px;
      }
    }

    @media (max-width:860px){
      .v2-nav__links{display:none;}
      /* .v2-section-head h2 / .v2-ind-h2 both floor at a fixed 42px on
         mobile (3.48vw of a ~390px phone is only ~13.6px, well under the
         clamp's 42px minimum) — badly oversized next to every other mobile
         heading on the page (e.g. .v2-trust__heading floors at 24px). Bring
         them down to the same order of magnitude as the rest of the page's
         mobile headings. */
      .v2-section-head h2, .v2-ind-h2{font-size:clamp(28px,7.5vw,38px);}
      /* .v2-stats-h2's white-space:nowrap (fine on desktop, where the
         clamp's larger min-width keeps it on one line) forces this same
         phrase onto one line here too, but at mobile widths it's too wide
         to fit — it was overflowing past both edges instead of wrapping. */
      /* Consistent mobile section rhythm (approved 2026-09-21): every
         section's own top padding is the ONLY thing that creates the gap
         above it — standardized to .v2-trust's existing 64px (its 130px
         desktop value was never meant for phones, and was stacking with
         .v2-hero's own trailing padding to create an oversized, inconsistent
         gap above the very first section after the hero). */
      .v2-hero{padding-bottom:0;}
      .v2-section{padding:64px 0;}
      .v2-access{padding:64px 0;}
      .v2-access-inner{gap:56px;}
      .v2-access-copy{gap:24px;}
      .v2-access-title{font-size:clamp(34px,9vw,44px); line-height:1.08;}
      .v2-access-form{min-height:76px; padding-block:16px;}
      .v2-access-form input{font-size:17px;}
      /* Bleed past .v2-wrap's gutter (edge-to-edge, now 16px) so the mockup
         below has the full viewport width to grow into instead of being
         capped by the reserved 280px box — it was rendering at 296px already
         (0.38 scale), narrower than even that box, and easy to miss/misread. */
      .v2-access-gallery{height:320px; max-width:none; margin-inline:-16px;}
      /* calc(88vw / 780px) gives a unitless scale factor, so the mockup's
         rendered width is always ~88% of the viewport (not a fixed px scale
         that's oversized on a 375px phone and undersized on a 430px one). */
      .v2-access-gallery__phone{--v2-hero-demo-scale:calc(88vw / 780px); width:calc(780px * var(--v2-hero-demo-scale)); height:calc(1598px * var(--v2-hero-demo-scale));}
      .v2-access-card{display:none;}
      /* 16px side padding to match every other section's mobile gutter. */
    }

    /* COMPARISON — mobile: stacked crossfade (bad underneath, good wipes in on
       top as the section scrolls through view), ported 1:1 from getflect.app's
       @media(max-width:767px) comparison rules. */
  </style>

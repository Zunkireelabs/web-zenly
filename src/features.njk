  <!-- ── OPERATIONS ─────────────────────────────────────────────────── -->
  <section class="section" id="operations">
    <div class="section__inner">

      <div class="fp-section-header reveal">
        <span class="section__badge">Operations</span>
        <h2 class="section__h2">Your whole floor, visible at a glance</h2>
        <p class="section__sub">Real-time dashboards for every role. Staff see their queue, managers see the floor, admins see everything — all from one platform.</p>

  <!-- ── FINANCIAL ──────────────────────────────────────────────────── -->
  <section class="section" id="financial">
    <div class="section__inner">

      <div class="fp-section-header reveal">
        <span class="section__badge">Finance</span>
        <h2 class="section__h2">Close your day in 30 seconds</h2>
        <p class="section__sub">Automated reconciliation, payment breakdowns by mode, and a full audit trail. No Excel. No guesswork. Every penny accounted for.</p>
      </div>

      <!-- Zigzag: visual left, text right -->
      <div class="entr-row reveal" data-delay="1">

        <div class="entr-row__visual">
          <div class="fp-visual-wrap fp-eod-panel">

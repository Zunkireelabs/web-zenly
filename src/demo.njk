---
layout: base.njk
title: Book a Demo — Zennly
bodyClass: page--light-nav
---

<main>

  <!-- ── HERO: gradient card, form left / pitch right ────────────────── -->
  <section class="demo-hero">
    <div class="demo-hero__card">
      <div class="demo-hero__form-wrap reveal">
        <h2 class="demo-card__headline">Let&rsquo;s talk.</h2>

        <div class="demo-card">
          <div class="demo-card__eyebrow">Book a call</div>

          <form class="demo-form" id="demo-form">

            <div class="demo-form__row">
              <div class="demo-form__field">
                <label for="demo-name">Full name</label>
                <input type="text" id="demo-name" name="name" required>
              </div>
              <div class="demo-form__field">
                <label for="demo-business">Business name</label>
                <input type="text" id="demo-business" name="business" required>
              </div>
            </div>

            <div class="demo-form__row">
              <div class="demo-form__field">
                <label for="demo-email">Email address</label>
                <input type="email" id="demo-email" name="email" required>
              </div>
              <div class="demo-form__field">
                <label for="demo-phone">Phone <span class="demo-form__optional">(optional)</span></label>
                <input type="tel" id="demo-phone" name="phone">
              </div>
            </div>

            <div class="demo-form__field">
              <label for="demo-branches">Number of branches</label>
              <select id="demo-branches" name="branches" required>
                <option value="" disabled selected>Select&hellip;</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5+">5+</option>
              </select>
            </div>

            <div class="demo-form__field">
              <label for="demo-challenge">Biggest operational challenge right now</label>
              <p class="demo-form__hint">This is how we configure your demo.</p>
              <textarea id="demo-challenge" name="challenge" rows="3" required></textarea>
            </div>

            <button type="submit" class="btn-primary demo-form__submit">Confirm my demo &rarr;</button>
          </form>

          <p class="demo-card__reassure">You&rsquo;ll receive a calendar invite immediately. We don&rsquo;t share your information. Ever.</p>
        </div>
      </div>

      <div class="demo-hero__copy reveal" data-delay="1">
        <div class="demo-hero__eyebrow">Book a demo</div>
        <h1 class="demo-hero__h1">See exactly how your branches run on one system.</h1>
        <p class="demo-hero__sub">Not a sales call. Not a slide deck. A live, 20&nbsp;minute walkthrough of the platform &mdash; configured around your business &mdash; so you can decide if it&rsquo;s right for you before committing to anything.</p>
      </div>
    </div>
  </section>

  <!-- ── STATS ────────────────────────────────────────────────────────── -->
  <section class="section demo-stats">
    <div class="section__inner">
      <div class="section__header reveal">
        <div class="section__badge">Why Zennly</div>
        <h2 class="section__h2">Run every branch on fewer systems.</h2>
      </div>

      <div class="demo-stats__grid reveal" data-delay="1">
        <div class="demo-stats__card">
          <div class="demo-stats__label">Bookings managed in a week</div>
          <div class="demo-stats__value">351</div>
        </div>
        <div class="demo-stats__card demo-stats__card--tint">
          <div class="demo-stats__label">Live status signals</div>
          <div class="demo-stats__value">800+</div>
        </div>
        <div class="demo-stats__card demo-stats__card--dark">
          <div class="demo-stats__label">Branches on one system</div>
          <div class="demo-stats__value">4</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── BOTTOM CTA ──────────────────────────────────────────────────── -->
  <section class="bottom-cta">
    <div class="bottom-cta__card bottom-cta__card--banner reveal">
      <h2 class="bottom-cta__h2">No pressure, no script &mdash; just Zennly, applied to your business.</h2>
      <p class="bottom-cta__sub">20 minutes. Bring your questions. We&rsquo;ll bring answers specific to how you operate.</p>
      <a href="#demo-form" class="bottom-cta__banner-btn">Book your demo &rarr;</a>
      <a href="https://zenly.zunkireelabs.com" target="_blank" rel="noopener" class="bottom-cta__link">See It Live &rarr;</a>
    </div>
  </section>

  <!-- ── FOOTER ─────────────────────────────────────────────────────── -->
  {% include "_footer-v2.njk" %}

  <script>
    (function () {
      var form = document.getElementById('demo-form');
      if (!form) return;

      var prefillEmail = new URLSearchParams(window.location.search).get('email');
      if (prefillEmail) {
        form.email.value = prefillEmail;
        form.name.focus();
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var f = form.elements;
        var body = [
          'Business name: ' + f.business.value,
          'Number of branches: ' + f.branches.value,
          'Phone: ' + (f.phone.value || '—'),
          'Biggest operational challenge: ' + f.challenge.value
        ].join('\n');
        var subject = 'Book a Demo — ' + f.business.value;
        var mailto = 'mailto:info.zunkireelabs@gmail.com'
          + '?subject=' + encodeURIComponent(subject)
          + '&body=' + encodeURIComponent('Name: ' + f.name.value + '\nEmail: ' + f.email.value + '\n\n' + body);
        window.location.href = mailto;
      });
    })();
  </script>

</main>

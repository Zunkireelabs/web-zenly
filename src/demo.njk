        <div class="demo-right">
          <div class="demo-card reveal" data-delay="1">
            <div class="demo-card__eyebrow">Book a call</div>
            <h2 class="demo-card__headline">Pick a time. We&rsquo;ll do the rest.</h2>

            <form class="demo-form" id="demo-form">

              <div class="demo-form__field">
                <label for="demo-name">Full name</label>
                <input type="text" id="demo-name" name="name" required>
              </div>

              <div class="demo-form__field">
                <label for="demo-business">Business name</label>
                <input type="text" id="demo-business" name="business" required>
              </div>

              <div class="demo-form__row">
                <div class="demo-form__field">
                  <label for="demo-email">Email address</label>
                  <input type="email" id="demo-email" name="email" required>
                </div>
                <div class="demo-form__field">
                  <label for="demo-phone">Phone <span class="demo-form__optional">(optional)</span></label>
                  <input type="tel" id="demo-phone" name="phone">
                </div>
              </div>

              <div class="demo-form__field">
                <label for="demo-branches">Number of branches</label>
                <select id="demo-branches" name="branches" required>
                  <option value="" disabled selected>Select&hellip;</option>
                  <option value="1">1</option>
                  <option value="2">2</option>
                  <option value="3">3</option>
                  <option value="4">4</option>
                  <option value="5+">5+</option>
                </select>
              </div>

              <div class="demo-form__field">
                <label for="demo-challenge">What&rsquo;s your biggest operational challenge right now?</label>
                <p class="demo-form__hint">This is how we configure your demo.</p>
                <textarea id="demo-challenge" name="challenge" rows="3" required></textarea>
              </div>

              <button type="submit" class="btn-primary demo-form__submit">Confirm my demo &rarr;</button>
            </form>

            <p class="demo-card__reassure">You&rsquo;ll receive a calendar invite immediately. We&rsquo;ll review your details before the call so your demo is specific to your business &mdash; not a generic walkthrough.</p>
            <p class="demo-card__privacy">We don&rsquo;t share your information. Ever.</p>
          </div>
        </div>

      </div>
    </div>
  </section>


---
dateModified: "2026-10-14"
layout: base.njk
title: "Contact Zennly — Questions, Support and Partnerships"
metaDescription: "Get in touch with the Zennly team. Ask about pricing, get support, or talk partnerships for your spa, salon or multi-branch service business in Nepal."
bodyClass: page--light-nav
---
{% from "schema/breadcrumb.njk" import breadcrumbSchema with context %}
{{ breadcrumbSchema([{ name: "Home", url: "/" }, { name: "Contact", url: "/contact/" }]) }}

<main>

  <!-- ── HERO: gradient card, form left / copy right ─────────────────── -->
  <section class="demo-hero">
    <div class="demo-hero__card">
      <div class="demo-hero__form-wrap reveal">
        <h2 class="demo-card__headline">Get in touch.</h2>

        <div class="demo-card">
          <div class="demo-card__eyebrow">Send a message</div>

          <form class="demo-form" id="contact-form">

            <div class="demo-form__row">
              <div class="demo-form__field">
                <label for="contact-name">Full name</label>
                <input type="text" id="contact-name" name="full_name" autocomplete="name" required>
              </div>
              <div class="demo-form__field">
                <label for="contact-email">Email address</label>
                <input type="email" id="contact-email" name="email" autocomplete="email" required>
              </div>
            </div>

            <div class="demo-form__field">
              <label for="contact-phone">Phone <span class="demo-form__optional">(optional)</span></label>
              <input type="tel" id="contact-phone" name="phone" autocomplete="tel">
            </div>

            <div class="demo-form__field">
              <p class="tf-label">What is this about?</p>
              <div class="tf-chips tf-chips--grid" role="radiogroup" aria-label="What is this about?">
                  <label class="tf-chip"><input type="radio" name="topic" value="general_question"><span>General question</span></label>
                  <label class="tf-chip"><input type="radio" name="topic" value="pricing"><span>Pricing</span></label>
                  <label class="tf-chip"><input type="radio" name="topic" value="support"><span>Support</span></label>
                  <label class="tf-chip"><input type="radio" name="topic" value="partnership"><span>Partnership</span></label>
                  <label class="tf-chip"><input type="radio" name="topic" value="press"><span>Press</span></label>
                  <label class="tf-chip"><input type="radio" name="topic" value="other"><span>Other</span></label>
              </div>
            </div>

            <div class="demo-form__field">
              <label for="contact-message">Your message</label>
              <textarea id="contact-message" name="message" rows="5" placeholder="Tell us a little about your business and what you need." required></textarea>
            </div>

            <p class="tf-error" id="contact-error" role="alert" hidden></p>

            <button type="submit" class="btn-primary demo-form__submit">Send message &rarr;</button>
          </form>

          <p class="demo-card__reassure">We reply within one working day. We don&rsquo;t share your information. Ever.</p>
        </div>
      </div>

      <div class="demo-hero__copy reveal" data-delay="1">
        <div class="demo-hero__eyebrow">Contact</div>
        <h1 class="demo-hero__h1">Questions? Talk to the people who build Zennly.</h1>
        <p class="demo-hero__sub">Ask about pricing, get help with your account, or explore a partnership. A real person on the Zennly team will read your message and reply.</p>

        <div class="demo-hero__cal-cta contact-cal">
          <p class="demo-card__cal-hint">Prefer to chat or email?</p>
          <a href="https://wa.me/9779747491787?text=Hi%20Zennly%2C%20I%20have%20a%20question." class="btn-secondary demo-card__cal-btn" target="_blank" rel="noopener">Chat on WhatsApp</a>
          <a href="mailto:info@zennly.io" class="btn-secondary demo-card__cal-btn">Send us an email</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── BOTTOM CTA ──────────────────────────────────────────────────── -->
  <section class="bottom-cta">
    <div class="bottom-cta__card bottom-cta__card--banner reveal">
      <h2 class="bottom-cta__h2">Want to see it running instead?</h2>
      <p class="bottom-cta__sub">Book a 20-minute walkthrough configured around your business.</p>
      <div class="bottom-cta__btn-row">
        <a href="/demo/" class="bottom-cta__banner-btn">Book a demo &rarr;</a>
      </div>
      <a href="/case-study/" class="bottom-cta__link">See It Live &rarr;</a>
    </div>
  </section>

  <!-- ── FOOTER ─────────────────────────────────────────────────────── -->
  {% include "_footer-v2.njk" %}

  {% include "_edgex-lead.njk" %}

  <script>
    (function () {
      var form = document.getElementById('contact-form');
      if (!form) return;
      var err = document.getElementById('contact-error');
      var chips = form.querySelectorAll('input[name="topic"]');
      var btn = form.querySelector('.demo-form__submit');
      var btnText = btn.innerHTML;
      var LABELS = { general_question: 'General question', pricing: 'Pricing', support: 'Support', partnership: 'Partnership', press: 'Press', other: 'Other' };

      // Preselect topic from ?topic=pricing etc.
      var want = (new URLSearchParams(window.location.search).get('topic') || '').toLowerCase().replace(/[\s-]+/g, '_');
      chips.forEach(function (c) { if (c.value === want) c.checked = true; });
      chips.forEach(function (c) { c.addEventListener('change', function () { err.hidden = true; }); });

      function mailFallback(f, topic) {
        var body = 'Name: ' + f.full_name.value + '\nEmail: ' + f.email.value + '\nPhone: ' + (f.phone.value || '—') + '\nTopic: ' + LABELS[topic] + '\n\n' + f.message.value;
        window.location.href = 'mailto:info@zennly.io'
          + '?subject=' + encodeURIComponent('Contact — ' + LABELS[topic])
          + '&body=' + encodeURIComponent(body);
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var f = form.elements;
        var picked = form.querySelector('input[name="topic"]:checked');
        if (!picked) { err.textContent = 'Pick what this is about so we can route it to the right person.'; err.hidden = false; return; }
        var topic = picked.value;
        err.hidden = true;
        btn.disabled = true; btn.textContent = 'Sending\u2026';
        window.zennlyPostLead('contact-us', {
          full_name: f.full_name.value.trim(),
          email: f.email.value.trim(),
          phone: f.phone.value.trim() || null,
          intake_source: 'Website',
          intake_account: window.location.pathname,
          custom_fields: { topic: topic, message: f.message.value.trim() }
        }).then(function () {
          var card = form.closest('.demo-card');
          card.innerHTML = '<div class="tf-done"><div class="tf-done__tick" aria-hidden="true">&#10003;</div><h2 class="demo-card__headline">Message sent.</h2><p class="demo-form__hint">Thanks. We reply within one working day.</p></div>';
        }).catch(function () {
          btn.disabled = false; btn.innerHTML = btnText;
          mailFallback(f, topic);
        });
      });
    })();
  </script>

</main>

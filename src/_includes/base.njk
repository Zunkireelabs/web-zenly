<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or "Zenly" }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/tailwind.css?v=6" />
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  <nav id="nav" class="nav" aria-label="Main navigation">
    <div class="nav__container">

      <!-- Zone 1: Logo -->
      <a href="/" class="nav__logo">Zenly</a>

      <!-- Zone 2: Links -->
      <ul class="nav__links" role="list">
        <li class="nav__item--has-mega">
          <a href="/features" class="nav__link nav__mega-trigger">
            Features
            <svg class="nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="nav-mega" role="region" aria-label="Features menu">
            <div class="nav-mega__grid">

              <a href="/features/booking" class="nav-mega__item">
                <span class="nav-mega__icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="3" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M5 1v4M11 1v4M1 7h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                </span>
                <span class="nav-mega__body">
                  <span class="nav-mega__name">Booking</span>
                  <span class="nav-mega__desc">Self-serve booking, 24/7</span>
                </span>
              </a>

              <a href="/features/operations" class="nav-mega__item">
                <span class="nav-mega__icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="1" width="6" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="9" y="1" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="9" y="7" width="6" height="8" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="1" y="10" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.4"/></svg>
                </span>
                <span class="nav-mega__body">
                  <span class="nav-mega__name">Operations</span>
                  <span class="nav-mega__desc">Real-time floor visibility</span>
                </span>
              </a>

              <a href="/features/finance" class="nav-mega__item">
                <span class="nav-mega__icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.4"/><path d="M8 5v3.5l2.5 1.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                </span>
                <span class="nav-mega__body">
                  <span class="nav-mega__name">Finance</span>
                  <span class="nav-mega__desc">Close your day in 30 seconds</span>
                </span>
              </a>

              <a href="/features/reports" class="nav-mega__item">
                <span class="nav-mega__icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 13V9M6 13V6M10 13V4M14 13V1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                </span>
                <span class="nav-mega__body">
                  <span class="nav-mega__name">Reports</span>
                  <span class="nav-mega__desc">8 built-in reports, always live</span>
                </span>
              </a>

              <a href="/features/industries" class="nav-mega__item">
                <span class="nav-mega__icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1" y="7" width="6" height="8" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="9" y="4" width="6" height="11" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="5" y="1" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.4"/></svg>
                </span>
                <span class="nav-mega__body">
                  <span class="nav-mega__name">Industries</span>
                  <span class="nav-mega__desc">Spa, salon, dental &amp; more</span>
                </span>
              </a>

              <a href="/features/multi-branch" class="nav-mega__item">
                <span class="nav-mega__icon">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="2.5" r="1.5" stroke="currentColor" stroke-width="1.4"/><circle cx="2.5" cy="13.5" r="1.5" stroke="currentColor" stroke-width="1.4"/><circle cx="13.5" cy="13.5" r="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M8 4v4M8 8l-4 4M8 8l4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                </span>
                <span class="nav-mega__body">
                  <span class="nav-mega__name">Multi-Branch</span>
                  <span class="nav-mega__desc">Scale across every location</span>
                </span>
              </a>

            </div>
            <div class="nav-mega__footer">
              <a href="/features" class="nav-mega__all">See all features &rarr;</a>
            </div>
          </div>
        </li>
        <li><a href="/how-it-works" class="nav__link">How it Works</a></li>
        <li><a href="/pricing"      class="nav__link">Pricing</a></li>
        <li><a href="#faq"          class="nav__link">FAQ</a></li>
      </ul>

      <!-- Zone 3: CTA + Hamburger -->
      <div class="nav__actions">
        <a href="#demo" class="btn-primary hidden md:inline-flex">Book a Demo</a>
        <button
          class="nav__hamburger"
          id="nav-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

    </div>

    <!-- Mobile slide-down menu -->
    <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
      <ul class="nav__mobile-links" role="list">
        <li class="nav__mobile-group">
          <span class="nav__mobile-label">Features</span>
          <ul class="nav__mobile-sub" role="list">
            <li><a href="/features/booking">Booking</a></li>
            <li><a href="/features/operations">Operations</a></li>
            <li><a href="/features/finance">Finance</a></li>
            <li><a href="/features/reports">Reports</a></li>
            <li><a href="/features/industries">Industries</a></li>
            <li><a href="/features/multi-branch">Multi-Branch</a></li>
            <li><a href="/features" class="nav__mobile-all">See all features &rarr;</a></li>
          </ul>
        </li>
        <li><a href="/how-it-works">How it Works</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
      <div class="nav__mobile-cta">
        <a href="#demo" class="btn-primary">Book a Demo</a>
      </div>
    </div>
  </nav>

  {{ content | safe }}

  <script src="/assets/vendor/alpine.min.js" defer></script>
  <script src="/assets/vendor/gsap.min.js"></script>
  <script src="/assets/vendor/ScrollTrigger.min.js"></script>
  <script src="/assets/vendor/SplitText.min.js"></script>
  <script src="/assets/vendor/lenis.min.js"></script>
  <script src="/assets/js/main.js?v=4" defer></script>
</body>
</html>

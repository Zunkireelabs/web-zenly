<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title or "Zenly" }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/css/tailwind.css?v=6" />
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>

  <nav id="nav" class="nav" aria-label="Main navigation">
    <div class="nav__container">

      <!-- Zone 1: Logo -->
      <a href="/" class="nav__logo">Zenly</a>

      <!-- Zone 2: Links -->
      <ul class="nav__links" role="list">
        <li class="nav__item--has-mega">
          <a href="/features" class="nav__link nav__mega-trigger">
            Features
            <svg class="nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <div class="nav-mega" role="region" aria-label="Features menu">
            <div class="nav-mega__container">
              <!-- Left Column: Core Features (Grid) -->
              <div class="nav-mega__left">
                <div class="nav-mega__label">Core Capabilities</div>
                <div class="nav-mega__grid">
                  <a href="/features/booking" class="nav-mega__item">
                    <div class="nav-mega__icon-wrapper">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-mega__icon">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                      </svg>
                    </div>
                    <div class="nav-mega__body">
                      <span class="nav-mega__name">Booking Engine</span>
                      <span class="nav-mega__desc">6-step flow with database-enforced conflict prevention.</span>
                    </div>
                  </a>

                  <a href="/features/operational-visibility" class="nav-mega__item">
                    <div class="nav-mega__icon-wrapper">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-mega__icon">
                        <rect x="3" y="3" width="7" height="9"/>
                        <rect x="14" y="3" width="7" height="5"/>
                        <rect x="14" y="12" width="7" height="9"/>
                        <rect x="3" y="16" width="7" height="5"/>
                      </svg>
                    </div>
                    <div class="nav-mega__body">
                      <span class="nav-mega__name">Operations</span>
                      <span class="nav-mega__desc">Real-time floor visibility, rosters, and staff dashboards.</span>
                    </div>
                  </a>

                  <a href="/features/payment-tracking" class="nav-mega__item">
                    <div class="nav-mega__icon-wrapper">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-mega__icon">
                        <line x1="12" y1="1" x2="12" y2="23"/>
                        <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                      </svg>
                    </div>
                    <div class="nav-mega__body">
                      <span class="nav-mega__name">Finance &amp; Reconciliation</span>
                      <span class="nav-mega__desc">30-second daily revenue closes and payment audits.</span>
                    </div>
                  </a>

                  <a href="/features/reports" class="nav-mega__item">
                    <div class="nav-mega__icon-wrapper">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-mega__icon">
                        <line x1="18" y1="20" x2="18" y2="10"/>
                        <line x1="12" y1="20" x2="12" y2="4"/>
                        <line x1="6" y1="20" x2="6" y2="14"/>
                      </svg>
                    </div>
                    <div class="nav-mega__body">
                      <span class="nav-mega__name">Live Reports</span>
                      <span class="nav-mega__desc">8 built-in reports showing real-time utilization.</span>
                    </div>
                  </a>

                  <a href="/features/discount-management" class="nav-mega__item">
                    <div class="nav-mega__icon-wrapper">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-mega__icon">
                        <line x1="19" y1="5" x2="5" y2="19"/>
                        <circle cx="6.5" cy="6.5" r="2.5"/>
                        <circle cx="17.5" cy="17.5" r="2.5"/>
                      </svg>
                    </div>
                    <div class="nav-mega__body">
                      <span class="nav-mega__name">Discount Management</span>
                      <span class="nav-mega__desc">Request-based discounts with real-time manager approval.</span>
                    </div>
                  </a>

                  <a href="/features/staff-management" class="nav-mega__item">
                    <div class="nav-mega__icon-wrapper">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-mega__icon">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                      </svg>
                    </div>
                    <div class="nav-mega__body">
                      <span class="nav-mega__name">Staff Management</span>
                      <span class="nav-mega__desc">Schedule staff transfers between branches with an effective date.</span>
                    </div>
                  </a>

                  <a href="/features/role-based-access" class="nav-mega__item">
                    <div class="nav-mega__icon-wrapper">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="nav-mega__icon">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                      </svg>
                    </div>
                    <div class="nav-mega__body">
                      <span class="nav-mega__name">Role-Based Access</span>
                      <span class="nav-mega__desc">Admin, manager, and staff — each with exactly the access their job requires.</span>
                    </div>
                  </a>
                </div>
              </div>

              <!-- Right Column: Config system panel (Grey Background panel) -->
              <div class="nav-mega__right">
                <div class="nav-mega__right-inner">
                  <div class="nav-mega__right-tag">Industry Engine</div>
                  <h4 class="nav-mega__right-title">Built for any vertical</h4>
                  <p class="nav-mega__right-text">Database-driven configuration overrides terminology and business rules out-of-the-box.</p>
                  
                  <div class="nav-mega__verticals">
                    <a href="/features/industries#spa" class="nav-mega__vertical-link">
                      <span class="nav-mega__vertical-bullet">●</span> Spas &amp; Wellness
                    </a>
                    <a href="/features/industries#salon" class="nav-mega__vertical-link">
                      <span class="nav-mega__vertical-bullet">●</span> Hair &amp; Nail Salons
                    </a>
                    <a href="/features/industries#dental" class="nav-mega__vertical-link">
                      <span class="nav-mega__vertical-bullet">●</span> Dental Clinics
                    </a>
                    <a href="/features/industries#tattoo" class="nav-mega__vertical-link">
                      <span class="nav-mega__vertical-bullet">●</span> Tattoo Studios
                    </a>
                  </div>

                  <div class="nav-mega__industry-cards">
                    <a href="/features/industries#spa" class="nav-mega__industry-card" style="background-image: url('/assets/images/nav-icon-spa.png');">
                      <span class="nav-mega__industry-card-label">Spa &amp; Wellness</span>
                    </a>
                    <a href="/features/industries#dental" class="nav-mega__industry-card" style="background-image: url('/assets/images/nav-icon-dental.png');">
                      <span class="nav-mega__industry-card-label">Dental Clinics</span>
                    </a>
                  </div>

                  <a href="/features/industries" class="nav-mega__right-cta">
                    See how it works
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="display:inline; margin-left: 2px;"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                </div>
              </div>
            </div>

            <!-- Global Mega Menu Footer -->
            <div class="nav-mega__footer">
              <span class="nav-mega__footer-text">Nuad Thai Spa Kathmandu is live with 39 therapists &amp; 12 rooms.</span>
              <a href="/features" class="nav-mega__footer-link">See All Features &rarr;</a>
            </div>
          </div>
        </li>
        <li><a href="/how-it-works" class="nav__link">How it Works</a></li>
        <li><a href="/pricing"      class="nav__link">Pricing</a></li>
        <li><a href="#faq"          class="nav__link">FAQ</a></li>
      </ul>

      <!-- Zone 3: CTA + Hamburger -->
      <div class="nav__actions">
        <a href="/demo" class="btn-primary hidden md:inline-flex">Book a Demo</a>
        <button
          class="nav__hamburger"
          id="nav-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>

    </div>

    <!-- Mobile slide-down menu -->
    <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
      <ul class="nav__mobile-links" role="list">
        <li class="nav__mobile-group">
          <span class="nav__mobile-label">Features</span>
          <ul class="nav__mobile-sub" role="list">
            <li><a href="/features/booking">Booking</a></li>
            <li><a href="/features/operational-visibility">Operations</a></li>
            <li><a href="/features/payment-tracking">Finance</a></li>
            <li><a href="/features/reports">Reports</a></li>
            <li><a href="/features/industries">Industries</a></li>
            <li><a href="/features/staff-management">Staff Management</a></li>
            <li><a href="/features/discount-management">Discount Management</a></li>
            <li><a href="/features" class="nav__mobile-all">See all features &rarr;</a></li>
          </ul>
        </li>
        <li><a href="/how-it-works">How it Works</a></li>
        <li><a href="/pricing">Pricing</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
      <div class="nav__mobile-cta">
        <a href="/demo" class="btn-primary">Book a Demo</a>
      </div>
    </div>
  </nav>

  <!-- Blur backdrop overlay for active mega menu (renders behind nav, blurs body content) -->
  <div class="nav-backdrop-overlay" aria-hidden="true"></div>

  {{ content | safe }}

  <script src="/assets/vendor/alpine.min.js" defer></script>
  <script src="/assets/vendor/gsap.min.js"></script>
  <script src="/assets/vendor/ScrollTrigger.min.js"></script>
  <script src="/assets/vendor/SplitText.min.js"></script>
  <script src="/assets/vendor/lenis.min.js"></script>
  <script src="/assets/js/main.js?v=4" defer></script>
</body>
</html>

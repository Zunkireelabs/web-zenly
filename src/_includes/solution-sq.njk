{#- /solutions/{slug}/ "sq" layout (approved 2026-10-23): Square's /industry/spa section order,
    Zennly styling (fd-page tokens, palette, About quote card, pink final CTA, white footer).
    Opt-in per solution via a `sq` block in solutions.json. CSS: "SOLUTIONS SQ LAYOUT" block in main.css. -#}
{% macro sqIcon(name) %}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == 'building' %}<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>
{% elif name == 'tag' %}<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>
{% elif name == 'check' %}<circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>
{% elif name == 'calendar' %}<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
{% elif name == 'clock' %}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{% elif name == 'card' %}<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/>
{% elif name == 'userplus' %}<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M17 11h5M19.5 8.5v5"/>
{% elif name == 'shield' %}<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/>
{% endif %}
</svg>
{% endmacro %}

{% macro sqScreen(slide) %}
{% set s = slide.screen %}
<div class="sq-screen sq-screen--{{ slide.type }}">
  {% if slide.type == 'calendar' %}
  <div class="sq-screen__top"><b>{{ s.title }}</b><span>{{ s.meta }}</span></div>
  <div class="sq-cal" style="--cols:{{ s.cols | length }}; --rows:{{ s.hours | length }}; --k:{{ s.hourScale or 1 }};{% if s.hourScaleMobile %} --km:{{ s.hourScaleMobile }};{% endif %}">
    <div class="sq-cal__hours">{% for h in s.hours %}<span>{{ h }}</span>{% endfor %}</div>
    {% for col in s.cols %}
    <div class="sq-cal__col">
      <span class="sq-cal__name">{{ col.name }}</span>
      <div class="sq-cal__track">
        {% for a in col.appts %}
        <div class="sq-cal__ev sq-tone--{{ a.tone }}{% if a.selected %} is-selected{% endif %}{% if a.len * (s.hourScale or 1) < 1 %} is-short{% endif %}{% if s.hourScaleMobile and a.len * s.hourScaleMobile < 1 %} is-short-m{% endif %}" style="--s:{{ a.start }}; --l:{{ a.len }};"><b>{{ a.client }}</b><span>{{ a.service }}</span></div>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% elif slide.type == 'discount' %}
  <div class="sq-screen__top"><b>{{ s.title }}</b><span class="sq-pill{% if s.statusTone != 'ok' %} sq-pill--amber{% endif %}">{{ s.status }}</span></div>
  <p class="sq-screen__line">{{ s.client }}</p>
  <p class="sq-screen__big">{{ s.amount }}</p>
  <dl class="sq-screen__rows">{% for r in s.rows %}<div><dt>{{ r[0] }}</dt><dd>{{ r[1] }}</dd></div>{% endfor %}</dl>
  {% if not s.noActions %}<div class="sq-screen__actions"><span class="sq-screen__btn">Decline</span><span class="sq-screen__btn sq-screen__btn--go">Approve</span></div>{% endif %}
  {% elif slide.type == 'transfer' %}
  <div class="sq-screen__top"><b>{{ s.title }}</b><span class="sq-pill">{{ s.status }}</span></div>
  <div class="sq-transfer">
    <span class="sq-transfer__avatar" aria-hidden="true">{{ s.name | first }}</span>
    <div><b>{{ s.name }}</b><span>{{ s.role }}</span></div>
  </div>
  <div class="sq-transfer__route"><span>{{ s.from }}</span><i aria-hidden="true">&rarr;</i><span>{{ s.to }}</span><em>{{ s.when }}</em></div>
  <p class="sq-screen__label">{{ s.listTitle }}</p>
  <ul class="sq-screen__list">{% for it in s.items %}<li><b>{{ it[0] }}</b><span>{{ it[1] }}</span><span>{{ it[2] }}</span></li>{% endfor %}</ul>
  {% elif slide.type == 'close' %}
  <div class="sq-screen__top"><b>{{ s.title }}</b><span class="sq-pill">{{ s.status }}</span></div>
  <p class="sq-screen__big">{{ s.total }}</p>
  <p class="sq-screen__line">{{ s.label }}</p>
  <ul class="sq-bars">{% for b in s.bars %}<li><span>{{ b[0] }}</span><i style="--w:{{ b[2] }}%"></i><b>{{ b[1] }}</b></li>{% endfor %}</ul>
  <p class="sq-screen__foot">{{ s.foot }}</p>
  {% endif %}
</div>
{% endmacro %}

{% set sq = solution.sq %}
{#- Placeholder proof (sq.proofPlaceholder: true) shows on `npm run dev` and staging (ELEVENTY_ENV=development)
    but is left out of production builds, so invented proof never ships. Real proof: drop the flag. -#}
{% set showProof = (not sq.proofPlaceholder) or eleventy.env.runMode == 'serve' or env == 'development' %}
<main class="fd-page fd-page--palette sq-page" data-slug="{{ solution.slug }}">

  <!-- 1. HERO — Square: text on white, then a wide image (our photo + live booking card + proof chip) -->
  <section class="sq-hero">
    <div class="fd-wrap">
      <div class="reveal">
        <p class="sq-eyebrow">{{ sq.eyebrow }}</p>
        <h1 class="sq-h1">{{ sq.h1 }} <em>{{ sq.h1Accent }}</em></h1>
        <p class="sq-lede">{{ sq.sub }}</p>
        <div class="fd-btns">
          <span class="cta-cap"><a href="#try-free" class="fd-btn fd-btn--dark" data-trial-open>Try a free demo</a><span class="cta-cap__note">Instant access · no call needed</span></span>
          <span class="cta-cap"><a href="/contact/" class="fd-btn fd-btn--soft">Talk to us</a><span class="cta-cap__note">Questions? Our team replies</span></span>
        </div>
      </div>
      <div class="sq-wide{% if sq.heroCardPos %} sq-wide--card-{{ sq.heroCardPos }}{% endif %} reveal-scale" data-delay="1">
        {% image solution.hero.image, solution.hero.imageAlt, { class: "sq-wide__img", loading: "eager", style: "object-position: center " ~ (sq.heroImageFocus or '50%') ~ ";" } %}
        <div class="sq-wide__card">
          <div class="sq-wide__card-top"><span>{{ sq.heroCard.meta }}</span><span class="sq-pill">{{ sq.heroCard.status }}</span></div>
          <b>{{ sq.heroCard.client }}</b>
          <span>{{ sq.heroCard.service }}</span>
          <span class="sq-wide__card-meta">{{ sq.heroCard.staff }}</span>
        </div>
        {% if sq.chip %}<div class="sq-wide__chip"><i aria-hidden="true"></i>{{ sq.chip }}</div>{% endif %}
        {% if sq.proofChip and showProof %}{% if sq.proofPlaceholder %}<!-- PLACEHOLDER proof -->{% endif %}<div class="sq-wide__chip"><i aria-hidden="true"></i>{{ sq.proofChip }}</div>{% endif %}
      </div>
    </div>
  </section>

  <!-- 2. GET STARTED — Square "Setup is simple / Switch seamlessly", as our three steps -->
  <section class="sq-steps">
    <div class="fd-wrap sq-steps__grid">
      {% for st in sq.steps %}
      <div class="sq-step reveal" data-delay="{{ loop.index0 }}">
        <span class="sq-ico">{{ sqIcon(st.icon) }}</span>
        <h2 class="sq-step__title">{{ st.title }}</h2>
        <p>{{ st.desc }}</p>
        <a href="{{ st.href }}" class="sq-link">{{ st.linkText }} &rarr;</a>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- 3. PRODUCT CAROUSEL — Square "Spa software designed to free up headspace": one story, four screens -->
  <section class="fd-sheet fd-sheet--cream sq-carousel">
    <div class="fd-wrap">
      <div class="fd-head-row reveal">
        <h2 class="fd-h2">{{ sq.carousel.heading }} <em>{{ sq.carousel.accent }}</em></h2>
        <p class="fd-head-row__sub">{{ sq.carousel.sub }}</p>
      </div>
    </div>
    <div class="sq-carousel__scroller" tabindex="0" aria-label="Product screens">
      <div class="sq-carousel__track">
        {% for slide in sq.carousel.slides %}
        <figure class="sq-slide" aria-label="{{ loop.index }} of {{ sq.carousel.slides | length }}">
          <div class="sq-slide__stage">{{ sqScreen(slide) }}</div>
          <figcaption class="sq-slide__cap"><h3>{{ slide.title }}</h3><p>{{ slide.desc }}</p></figcaption>
        </figure>
        {% endfor %}
      </div>
    </div>
    <div class="fd-wrap sq-carousel__nav">
      <div class="sq-carousel__dots" aria-hidden="true">{% for slide in sq.carousel.slides %}<i{% if loop.first %} class="is-on"{% endif %}></i>{% endfor %}</div>
      <button type="button" class="sq-carousel__btn" data-sq="-1" aria-label="Previous screen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
      <button type="button" class="sq-carousel__btn" data-sq="1" aria-label="Next screen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
    </div>
  </section>

  <!-- 4. SIX FEATURES — Square "Never miss a booking / Avoid scheduling errors …", linked to our feature pages -->
  <section class="fd-sheet fd-sheet--white sq-features">
    <div class="fd-wrap">
      <h2 class="fd-h2 reveal">{{ sq.features.heading }} <em>{{ sq.features.accent }}</em></h2>
      <div class="sq-features__grid">
        {% for f in sq.features.items %}
        <div class="sq-feature reveal" data-delay="{{ loop.index0 % 3 }}">
          <span class="sq-ico">{{ sqIcon(f.icon) }}</span>
          <h3>{{ f.title }}</h3>
          <p>{{ f.desc }}</p>
          <a href="{{ f.href }}" class="sq-link">{{ f.linkText }} &rarr;</a>
        </div>
        {% endfor %}
      </div>
      <div class="fd-btns sq-features__btns">
        <a href="#try-free" class="fd-btn fd-btn--dark" data-trial-open>Try a free demo</a>
        <a href="/features/" class="fd-btn fd-btn--soft">Explore all features</a>
      </div>

      <!-- 5. NUMBERS — Square's data band; real figures from a live client (or flagged placeholders) -->
      {% if sq.stats and showProof %}
      {% if sq.proofPlaceholder %}<!-- PLACEHOLDER proof -->{% endif %}
      <div class="sq-stats reveal">
        <h2 class="sq-stats__title">{{ sq.stats.heading }}</h2>
        {% for st in sq.stats.items %}<div class="sq-stats__item"><b>{{ st[0] }}</b><span>{{ st[1] }}</span></div>{% endfor %}
      </div>
      {% if sq.stats.source %}<p class="sq-stats__src">{{ sq.stats.source }}</p>{% endif %}
      {% endif %}
    </div>
  </section>

  <!-- 6. CUSTOMER QUOTE — About page quote card (photo optional) -->
  {% set q = sq.quote %}
  {% if q and showProof %}
  {% if sq.proofPlaceholder %}<!-- PLACEHOLDER proof -->{% endif %}
  <section class="fd-sheet fd-sheet--cream">
    <div class="fd-wrap">
      <figure class="ab-quote{% if not q.photo %} ab-quote--solo{% endif %} reveal">
        <div class="ab-quote__body">
          <blockquote class="ab-quote__q">&ldquo;{{ q.text }}&rdquo;</blockquote>
          <figcaption class="ab-quote__by">
            <span class="ab-quote__who">{{ q.author }}<span>{{ q.meta }}</span></span>
            {% if q.href %}<a href="{{ q.href }}" class="fd-btn fd-btn--dark">{{ q.linkText or 'Read the case study' }}</a>{% endif %}
          </figcaption>
        </div>
        {% if q.photo %}<div class="ab-quote__media">{% image q.photo, q.photoAlt, { loading: "lazy" } %}</div>{% endif %}
      </figure>
    </div>
  </section>
  {% endif %}

  <!-- 7. GROW CARDS — Square "Connect every side of your spa" -->
  <section class="fd-sheet fd-sheet--white sq-grow">
    <div class="fd-wrap">
      <div class="fd-head-row reveal">
        <h2 class="fd-h2">{{ sq.grow.heading }} <em>{{ sq.grow.accent }}</em></h2>
        <p class="fd-head-row__sub">{{ sq.grow.sub }}</p>
      </div>
      <div class="sq-grow__grid">
        {% for c in sq.grow.cards %}
        {% set g = c.screen %}
        <a href="{{ c.href }}" class="sq-grow__card reveal" data-delay="{{ loop.index0 % 2 }}">
          <div class="sq-gp sq-gp--{{ c.tone }}{% if c.photo %} has-photo{% endif %}{% if c.screen.toast %} has-toast{% endif %}">
            {% if c.photo %}<div class="sq-gp__photo">{% image c.photo, c.photoAlt, { loading: "lazy" } %}</div>{% endif %}
            <div class="sq-gp__ui">
              <div class="sq-gp__top"><span>{{ g.label }}</span>{% if g.status %}<span class="sq-pill">{{ g.status }}</span>{% endif %}</div>
              <p class="sq-gp__name">{{ g.name or g.sub }}</p>
              {% if c.type == 'membership' %}
              <b class="sq-gp__num" data-num="{{ g.from }},{{ g.to }}" data-prefix="$">${{ g.to }}</b>
              <span class="sq-gp__cap">{{ g.caption }}</span>
              <div class="sq-gp__row" data-at="1"><span>{{ g.row[0] }}</span><b>{{ g.row[1] }}</b></div>
              {% elif c.type == 'package' %}
              <b class="sq-gp__num" data-num="{{ g.total }},{{ g.total - g.used }}">{{ g.total - g.used }} of {{ g.total }}</b>
              <span class="sq-gp__cap">{{ g.caption }}</span>
              <div class="sq-gp__dots" aria-hidden="true">{% for i in range(0, g.total) %}<i{% if i < g.used %} class="is-used" data-at="1"{% endif %}></i>{% endfor %}</div>
              <div class="sq-gp__row" data-at="1"><span>{{ g.row[0] }}</span><span class="sq-pill">{{ g.row[1] }}</span></div>
              {% elif c.type == 'voucher' %}
              <b class="sq-gp__num" data-num="{{ g.steps | join(',') }}" data-prefix="$">${{ g.steps | last }}</b>
              <span class="sq-gp__cap">{{ g.caption }}</span>
              {% for r in g.rows %}<div class="sq-gp__row" data-at="{{ loop.index }}"><span>{{ r[0] }}</span><b>{{ r[1] }}</b></div>{% endfor %}
              {% elif c.type == 'campaign' %}
              <b class="sq-gp__num" data-num="0,{{ g.to }}">{{ g.to }}</b>
              <span class="sq-gp__cap">{{ g.caption }}</span>
              <ul class="sq-gp__bars">{% for b in g.bars %}<li><span>{{ b[0] }}</span><i data-at="1" style="--w:{{ (b[1] / g.bars[0][1] * 100) | round }}%"></i><b>{{ b[1] }}</b></li>{% endfor %}</ul>
              {% endif %}
              {% if g.foot %}<p class="sq-gp__foot">{{ g.foot }}</p>{% endif %}
            </div>
            {% if g.toast %}<div class="sq-gp__toast" data-at="1"><i aria-hidden="true"></i><span>{{ g.toast[0] }}</span><b>{{ g.toast[1] }}</b></div>{% endif %}
          </div>
          <h3>{{ c.title }}</h3>
          <p>{{ c.desc }}</p>
          <span class="sq-link">{{ c.linkText }} &rarr;</span>
        </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 8. DARK FAQ — Square / Acuity dark accordion (CLAUDE.md solutions exception) -->
  <section class="fd-sheet fd-faq sq-faq" id="faq">
    <div class="fd-wrap fd-faq__grid">
      <div class="fd-faq__head reveal">
        <h2 class="fd-h2">{{ sq.faq.heading }} <em>{{ sq.faq.accent }}</em></h2>
      </div>
      <div class="fd-faq__list" x-data="{ open: 0, all: false }">
        {% for item in solution.faq %}
        <div class="fd-faq__item" :class="{ 'is-open': open === {{ loop.index0 }} }"{% if loop.index > sq.faq.visible %} x-show="all" x-cloak{% endif %}>
          <button class="fd-faq__q" @click="open = open === {{ loop.index0 }} ? null : {{ loop.index0 }}" :aria-expanded="open === {{ loop.index0 }}">
            <span>{{ item.question }}</span>
            <span class="fd-faq__icon" aria-hidden="true"></span>
          </button>
          <div class="fd-faq__a" x-show="open === {{ loop.index0 }}"{% if not loop.first %} x-cloak{% endif %}>
            <p>{{ item.answer }}</p>
          </div>
        </div>
        {% endfor %}
        {% if solution.faq | length > sq.faq.visible %}
        <button type="button" class="sq-faq__more" x-show="!all" @click="all = true">Show {{ (solution.faq | length) - sq.faq.visible }} more questions</button>
        {% endif %}
      </div>
    </div>
  </section>

  <!-- 9. FINAL CTA — pink band + phone (colour trial, About final) -->
  <section class="fd-sheet fd-band fd-final ab-final" id="demo">
    <div class="fd-wrap ab-final__in">
      <div class="reveal">
        <h2 class="fd-h2">{{ sq.final.heading }} <em>{{ sq.final.accent }}</em></h2>
        <div class="fd-btns">
          <span class="cta-cap"><a href="#try-free" class="fd-btn fd-btn--white" data-trial-open>Try a free demo</a><span class="cta-cap__note">Instant access · no call needed</span></span>
          <span class="cta-cap"><a href="/contact/" class="fd-btn fd-btn--glass">Talk to us</a><span class="cta-cap__note">Questions? Our team replies</span></span>
        </div>
      </div>
      <div class="ab-final__phone"><div class="ab-phone">{% image "/assets/images/mobile-mockup.png", "Zennly calendar on a phone", { loading: "lazy" } %}</div></div>
    </div>
  </section>

  {% include "_footer-v2.njk" %}

  <script>
  (function () {
    var sc = document.querySelector('.sq-carousel__scroller');
    if (!sc) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var slides = sc.querySelectorAll('.sq-slide');
    var dots = document.querySelectorAll('.sq-carousel__dots i');
    var btns = document.querySelectorAll('.sq-carousel__btn');
    var pitch = function () { return slides[1] ? slides[1].offsetLeft - slides[0].offsetLeft : sc.clientWidth; };
    var sync = function () {
      var i = Math.round(sc.scrollLeft / pitch());
      dots.forEach(function (d, n) { d.classList.toggle('is-on', n === i); });
      btns[0].disabled = sc.scrollLeft < 4;
      btns[1].disabled = sc.scrollLeft > sc.scrollWidth - sc.clientWidth - 4;
    };
    btns.forEach(function (b) { b.addEventListener('click', function () { sc.scrollBy({ left: +b.dataset.sq * pitch(), behavior: reduce ? 'auto' : 'smooth' }); }); });
    sc.addEventListener('scroll', sync, { passive: true }); window.addEventListener('resize', sync); sync();
  })();
  </script>
  <script>
  (function () {
    // Grow panels: numbers tick through their steps once in view; [data-at=n] parts appear when step n is reached.
    var panels = document.querySelectorAll('.sq-gp');
    if (!panels.length || !('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var fmt = function (el, v) { var p = el.dataset.prefix || ''; var t = el.textContent.indexOf(' of ') > -1 ? ' of ' + el.textContent.split(' of ')[1] : ''; el.textContent = p + Math.round(v).toLocaleString('en-US') + t; };
    var play = function (panel) {
      var num = panel.querySelector('[data-num]'); if (!num) return;
      var steps = num.dataset.num.split(',').map(Number), i = 0;
      var next = function () {
        if (++i >= steps.length) return;
        var a = steps[i - 1], b = steps[i], t0 = null;
        var tick = function (t) { t0 = t0 || t; var k = Math.min((t - t0) / 900, 1), e = 1 - Math.pow(1 - k, 3); fmt(num, a + (b - a) * e);
          if (k < 1) return requestAnimationFrame(tick);
          panel.querySelectorAll('[data-at="' + i + '"]').forEach(function (el) { el.classList.add('is-in'); });
          setTimeout(next, 700); };
        requestAnimationFrame(tick);
      };
      setTimeout(next, 500);
    };
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { io.unobserve(e.target); play(e.target); } }); }, { threshold: 0.5 });
    panels.forEach(function (p) {
      p.classList.add('is-armed');
      var num = p.querySelector('[data-num]'); if (num) fmt(num, +num.dataset.num.split(',')[0]);
      io.observe(p);
    });
  })();
  </script>
</main>

---
layout: base.njk
---

<main>

  <!-- ── HERO ────────────────────────────────────────────────────────────── -->
  <section class="fd-hero">
    <div class="fd-hero__inner">

      <div class="fd-hero__text">
        <h1 class="fd-hero__h1">{{ feature.hero.headline | safe }}</h1>
        <div class="fd-hero__actions fd-hero__actions--compact">
          <a href="mailto:info.zunkireelabs@gmail.com" class="btn-primary">{{ feature.hero.cta if feature.hero.cta else "Book a Demo" }}</a>
        </div>
        {% if feature.hero.trustLine %}
        <p class="fd-hero__trust">{{ feature.hero.trustLine }}</p>
        {% endif %}
      </div>

      <!-- The new Hero Product Deck Card -->
      <div class="fd-hero__deck" data-feature="{{ feature.slug }}">
        <div class="fd-hero__deck-info">
          <h3 class="fd-hero__deck-heading">
            {{ feature.hero.subheadline }}
          </h3>
          {% if feature.primaryFeatures.length %}
          <ul class="fd-hero__deck-list">
            {% for feat in feature.primaryFeatures | slice(0, 3) %}
            <li>
              <span class="fd-hero__deck-check">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </span>
              <span>{{ feat.title }}</span>
            </li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
        <div class="fd-hero__deck-media">
          {% if feature.slug == 'booking' %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">Today&rsquo;s bookings</p>
                <p class="fd-hero__mockup-date">Thu, 3 Jul &middot; Lazimpat branch</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list" data-hero-mockup>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">A</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">A. Sharma</p>
                  <p class="fd-hero__mockup-service">Deep tissue massage &middot; 60 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">M</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Manisha T.</p>
                  <p class="fd-hero__mockup-service">Hot stone therapy &middot; 90 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">R</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">R. Gurung</p>
                  <p class="fd-hero__mockup-service">Facial &amp; skincare &middot; 45 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">S</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">S. Koirala</p>
                  <p class="fd-hero__mockup-service">Aromatherapy &middot; 60 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
            </div>
          </div>
          {% elif feature.slug == 'operational-visibility' %}

---
layout: base.njk
---
{% from "schema/faq.njk" import faqSchema %}
{{ faqSchema(feature.objections.items) }}
{% from "schema/breadcrumb.njk" import breadcrumbSchema with context %}
{{ breadcrumbSchema([{ name: "Home", url: "/" }, { name: "Features", url: "/features/" }, { name: feature.name, url: "/features/" + feature.slug + "/" }]) }}

<main class="fd-page{% if feature.slug in ['booking','operational-visibility','payment-tracking','reports','discount-management','staff-management','role-based-access','memberships','packages','vouchers','campaigns','outreach','payroll','ai-assistant'] %} fd-page--palette fd-scene--ocean{% endif %}">

  <!-- ── HERO ────────────────────────────────────────────────────────────── -->
  <section class="fd-hero" data-feature="{{ feature.slug }}">
    <div class="fd-hero__text">
      {% if feature.hero.eyebrow %}<span class="fd-hero__chip"><i aria-hidden="true"></i>{{ feature.hero.eyebrow }}</span>{% endif %}
      <h1 class="fd-hero__h1">{{ feature.hero.headline | safe }}</h1>
      {% if feature.hero.subheadline %}<p class="fd-hero__lede">{{ feature.hero.subheadline }}</p>{% endif %}
      <div class="fd-btns">
        <span class="cta-cap"><button type="button" class="fd-btn fd-btn--dark" data-trial-open>Try a free demo ↗</button><span class="cta-cap__note">Instant access · no call needed</span></span>
        <span class="cta-cap"><a href="/contact/" class="fd-btn fd-btn--soft">Talk to us ↗</a><span class="cta-cap__note">Questions? Our team replies</span></span>
      </div>
      {% if feature.hero.trustLine %}
      <p class="fd-hero__trust">{{ feature.hero.trustLine }}</p>
      {% endif %}
    </div>

    <div class="fd-hero__deck fd-hero__stage" data-feature="{{ feature.slug }}">
        <div class="fd-hero__deck-media">
          {% if feature.slug == 'booking' %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">Today&rsquo;s bookings</p>
                <p class="fd-hero__mockup-date">Thu, Jul 3 &middot; Downtown branch</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list" data-hero-mockup>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">A</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">A. Carter</p>
                  <p class="fd-hero__mockup-service">Deep tissue massage &middot; 60 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">M</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Megan T.</p>
                  <p class="fd-hero__mockup-service">Hot stone therapy &middot; 90 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">R</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">R. Garcia</p>
                  <p class="fd-hero__mockup-service">Facial &amp; skincare &middot; 45 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">S</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">S. Collins</p>
                  <p class="fd-hero__mockup-service">Aromatherapy &middot; 60 min</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
            </div>
          </div>
          {% elif feature.slug == 'operational-visibility' %}
          {# Static on purpose: the three statuses tell the 11:30 moment of the workflow story #}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">Live branch feed</p>
                <p class="fd-hero__mockup-date">Today &middot; 11:30 AM &middot; All branches</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list">
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">L</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Downtown</p>
                  <p class="fd-hero__mockup-service">Ashley C. &middot; Deep Tissue &middot; Emily C.</p>
                </div>
                <span class="fd-hero__mockup-status is-done"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>Completed</span></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">P</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Midtown</p>
                  <p class="fd-hero__mockup-service">Hot Stone &middot; Rachel S. &middot; since 10:20</p>
                </div>
                <span class="fd-hero__mockup-status is-warn"><span class="fd-hero__mockup-warn-dot"></span><span>10 min over</span></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">B</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Uptown</p>
                  <p class="fd-hero__mockup-service">Allison T. &middot; Facial &middot; 12:00</p>
                </div>
                <span class="fd-hero__mockup-status"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Confirmed</span></span>
              </div>
            </div>
          </div>
          {% elif feature.slug == 'payment-tracking' %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">Today&rsquo;s payments</p>
                <p class="fd-hero__mockup-date">Thursday &middot; Downtown</p>
              </div>
              <span class="fd-hero__mockup-live"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Day closed</span>
            </div>
            <div class="dash-stats-grid">
              <div class="dash-card">
                <div class="dash-card__header">
                  <span class="dash-card__icon-wrap color-today">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                  </span>
                  <span class="dash-card__label">Today</span>
                </div>
                <div class="dash-card__value">$1,860</div>
                <div class="dash-card__sub">Collected</div>
                <div class="dash-card__footer">
                  <span>Payments</span>
                  <span class="dash-card__footer-val">16</span>
                </div>
              </div>
              <div class="dash-card">
                <div class="dash-card__header">
                  <span class="dash-card__icon-wrap color-yest">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                  </span>
                  <span class="dash-card__label">Yesterday</span>
                </div>
                <div class="dash-card__value">$1,710</div>
                <div class="dash-card__sub">Collected</div>
                <div class="dash-card__footer">
                  <span>Payments</span>
                  <span class="dash-card__footer-val">15</span>
                </div>
              </div>
              <div class="dash-card">
                <div class="dash-card__header">
                  <span class="dash-card__icon-wrap color-wtd">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                  </span>
                  <span class="dash-card__label">This week</span>
                </div>
                <div class="dash-card__value">$8,340</div>
                <div class="dash-card__sub">Collected</div>
                <div class="dash-card__footer">
                  <span>Payments</span>
                  <span class="dash-card__footer-val">71</span>
                </div>
              </div>
              <div class="dash-card">
                <div class="dash-card__header">
                  <span class="dash-card__icon-wrap color-mtd">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                  </span>
                  <span class="dash-card__label">This month</span>
                </div>
                <div class="dash-card__value">$33,300</div>
                <div class="dash-card__sub">Collected</div>
                <div class="dash-card__footer">
                  <span>Payments</span>
                  <span class="dash-card__footer-val">284</span>
                </div>
              </div>
            </div>
          </div>
          {% elif feature.slug == 'staff-management' %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">Staff transfers</p>
                <p class="fd-hero__mockup-date">Mon, Jul 7 &middot; All branches</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list" data-hero-mockup>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">P</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Paige N.</p>
                  <p class="fd-hero__mockup-service">Downtown &rarr; Midtown &middot; Eff. Thu, Jul 10</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">J</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Jordan P.</p>
                  <p class="fd-hero__mockup-service">Uptown &rarr; Downtown &middot; Eff. Thu, Jul 17</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">O</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Olivia P.</p>
                  <p class="fd-hero__mockup-service">Midtown &rarr; Uptown &middot; Eff. Mon, Jul 21</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">L</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Lauren H.</p>
                  <p class="fd-hero__mockup-service">Downtown &rarr; Uptown &middot; Eff. Mon, Jul 28</p>
                </div>
                <span class="fd-hero__mockup-status"></span>
              </div>
            </div>
          </div>
          {% elif feature.slug == 'discount-management' %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">Discount requests</p>
                <p class="fd-hero__mockup-date">Today &middot; Downtown</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-grid" data-discount-mockup>
              <div class="fd-hero__mockup-tile" data-discount-item>
                <div class="fd-hero__mockup-tile-top">
                  <span class="fd-hero__mockup-avatar">M</span>
                  <span class="fd-hero__mockup-status" data-discount-status>Pending</span>
                </div>
                <p class="fd-hero__mockup-name">Megan T. &middot; 15% off</p>
                <p class="fd-hero__mockup-service">Hot stone therapy</p>
              </div>
              <div class="fd-hero__mockup-tile is-done">
                <div class="fd-hero__mockup-tile-top">
                  <span class="fd-hero__mockup-avatar">R</span>
                  <span class="fd-hero__mockup-status is-done"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Approved</span>
                </div>
                <p class="fd-hero__mockup-name">R. Garcia &middot; 10% off</p>
                <p class="fd-hero__mockup-service">Facial &amp; skincare</p>
              </div>
              <div class="fd-hero__mockup-tile" data-discount-item>
                <div class="fd-hero__mockup-tile-top">
                  <span class="fd-hero__mockup-avatar">S</span>
                  <span class="fd-hero__mockup-status" data-discount-status>Pending</span>
                </div>
                <p class="fd-hero__mockup-name">S. Collins &middot; 25% off</p>
                <p class="fd-hero__mockup-service">Aromatherapy</p>
              </div>
              <div class="fd-hero__mockup-tile is-done">
                <div class="fd-hero__mockup-tile-top">
                  <span class="fd-hero__mockup-avatar">A</span>
                  <span class="fd-hero__mockup-status is-done"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Approved</span>
                </div>
                <p class="fd-hero__mockup-name">A. Carter &middot; 20% off</p>
                <p class="fd-hero__mockup-service">Deep tissue massage</p>
              </div>
            </div>
          </div>
          {% elif feature.slug == 'role-based-access' %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">Access by role</p>
                <p class="fd-hero__mockup-date">Thursday &middot; All branches</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list">
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">A</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Admin</p>
                  <p class="fd-hero__mockup-service">All branches &middot; full visibility</p>
                </div>
                <span class="fd-hero__mockup-status is-done">Full access</span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">M</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Manager</p>
                  <p class="fd-hero__mockup-service">Downtown branch &middot; approvals</p>
                </div>
                <span class="fd-hero__mockup-status">Branch-level</span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">S</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Staff</p>
                  <p class="fd-hero__mockup-service">Today&rsquo;s schedule &middot; own bookings</p>
                </div>
                <span class="fd-hero__mockup-status">Own queue</span>
              </div>
            </div>
          </div>
          {% elif feature.slug == 'reports' %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">June at a glance</p>
                <p class="fd-hero__mockup-date">All three branches</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list">
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/></svg></span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Revenue</p>
                  <p class="fd-hero__mockup-service">All branches</p>
                </div>
                <span class="fd-hero__mockup-figure">$89,050</span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Staff performance</p>
                  <p class="fd-hero__mockup-service">Per staff member</p>
                </div>
                <span class="fd-hero__mockup-figure">18 staff</span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41L13.42 20.58a2 2 0 0 1-2.83 0L2.59 12.58V2h10.59l8.41 8.41a2 2 0 0 1 0 2.83z"/><circle cx="7" cy="7" r="1.5"/></svg></span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Discounts</p>
                  <p class="fd-hero__mockup-service">This month</p>
                </div>
                <span class="fd-hero__mockup-figure">$1,140</span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg></span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Referrals</p>
                  <p class="fd-hero__mockup-service">Of new bookings</p>
                </div>
                <span class="fd-hero__mockup-figure">42%</span>
              </div>
            </div>
          </div>
          {% elif feature.heroMockup %}
          <div class="fd-hero__mockup" aria-hidden="true">
            <div class="fd-hero__mockup-top">
              <div>
                <p class="fd-hero__mockup-title">{{ feature.heroMockup.title }}</p>
                <p class="fd-hero__mockup-date">{{ feature.heroMockup.date }}</p>
              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list">
              {% for row in feature.heroMockup.rows %}
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">{{ row.avatar }}</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">{{ row.name }}</p>
                  <p class="fd-hero__mockup-service">{{ row.service }}</p>
                </div>
                <span class="fd-hero__mockup-status{% if row.done %} is-done{% endif %}">{{ row.status }}</span>
              </div>
              {% endfor %}
            </div>
          </div>
          {% else %}
          <div class="fd-hero__img-wrap">
            {% image feature.hero.image, feature.hero.imageAlt, { class: "fd-hero__img", loading: "eager" } %}
          </div>
          {% endif %}
        </div>
    </div>
  </section>

  <!-- ── THE PROBLEM ───────────────────────────────────────────────────── -->
  {% if feature.problem %}
  <section class="section fd-problem">
    <div class="section__inner">
      <div class="section__header reveal">
        <h2 class="section__h2">{{ feature.problem.headline | safe }}</h2>
      </div>
      {% if feature.problem.body %}
      <p class="fd-problem__body reveal">{{ feature.problem.body }}</p>
      {% endif %}
      {% if feature.problem.panels %}
      <div class="fd-problem__grid reveal">
        {% for panel in feature.problem.panels %}
        <div class="fd-problem__card">
          <span class="fd-problem__emoji" aria-hidden="true">{{ panel.emoji }}</span>
          <h3 class="fd-problem__title">{{ panel.title }}</h3>
          <p class="fd-problem__text">{{ panel.body }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <!-- ── LIFECYCLE (sticky numbered scroll) ─────────────────────────────────
       Skipped when feature.workflow is present — that timeline already
       covers the same status walkthrough with more concrete detail. ── -->
  {% if not feature.workflow %}
  <section class="section fd-lifecycle">
    <div class="section__inner">
      <div class="section__header reveal">
        <h2 class="section__h2">{{ feature.intro.headline if feature.intro else "Here's how it happens" }}</h2>
        {% if feature.intro.body %}
        <p class="section__sub">{{ feature.intro.body }}</p>
        {% endif %}
      </div>
      <div class="fd-lifecycle-scroll" data-lifecycle-scroll>
        <div class="fd-lifecycle-scroll__nums">
          {% for item in feature.howItWorks %}
          <div class="fd-lifecycle-scroll__num{% if loop.first %} is-active{% endif %}">{{ item.step }}</div>
          {% endfor %}
        </div>
        <div class="fd-lifecycle-scroll__text-col">
          {% for item in feature.howItWorks %}
          <div class="fd-lifecycle-scroll__item{% if loop.first %} is-active{% endif %}">
            <div class="fd-lifecycle-scroll__card">
              <h3 class="fd-lifecycle-scroll__title">{{ item.title }}</h3>
              <p class="fd-lifecycle-scroll__desc">{{ item.description }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ── WORKFLOW TIMELINE (sticky-scroll steps + phone mockup) ─────────── -->
  {% if feature.workflow %}
  {# List mode (2026-10-21, booking first): all steps visible as a timeline list, rail on the list's left edge, click to jump. #}
  {# Flow mode (2026-10-21, booking first, Square-style): sticky phone left, steps scroll natively on the
     right with icon tiles; replaces the pinned list mode where enabled. List mode kept as a fallback:
     move a slug from wfFlow to wfList to switch back. #}
  {% set wfFlow = feature.slug in ['booking','operational-visibility','payment-tracking','reports','discount-management','staff-management','role-based-access','memberships','packages','vouchers','campaigns','outreach','payroll','ai-assistant'] %}
  {% set wfList = feature.slug in [] %}
  <section class="fd-workflow{% if wfList %} fd-wf--list{% endif %}{% if wfFlow %} fd-wf--flow{% endif %}">
    <div class="section__inner">
      <!-- Head sits INSIDE .fd-workflow__pin-wrap (not as its own sibling in
           .section__inner) so its sticky containing block is exactly
           pin-wrap's own height, same as .fd-workflow__sticky's. Previously,
           as a sibling before pin-wrap, its containing block was
           head+pinwrap tall, so it kept sticking for a bit after the phone
           mockup had already released at the end of pin-wrap. -->
      <div class="fd-workflow__pin-wrap" data-workflow-scroll style="--wf-steps: {{ feature.workflow | length }}">
        <div class="fd-workflow__head reveal">
          <h2 class="fd-workflow__heading">{{ feature.workflowHeading | safe if feature.workflowHeading else "How a booking day runs on <span class=\"fd-workflow__heading-accent\">Zennly.</span>" | safe }}</h2>
          <p class="fd-workflow__sub">{{ feature.workflowSub if feature.workflowSub else "A real timeline of one appointment, hour by hour." }}</p>
        </div>

        <div class="fd-workflow__sticky">
          <div class="fd-workflow__layout">

            <div class="fd-workflow__steps">
              {% if wfList %}
              <div class="fd-workflow__rail" aria-hidden="true">
                <span class="fd-workflow__rail-fill" data-workflow-fill></span>
                <span class="fd-workflow__rail-dot" data-workflow-dot></span>
              </div>
              {% endif %}
              {% for item in feature.workflow %}
              <div class="fd-workflow__step{% if loop.first %} is-active{% endif %}" data-workflow-step="{{ loop.index0 }}"{% if wfList or wfFlow %} role="button" tabindex="0" aria-label="Step {{ loop.index }} of {{ loop.length }}: {{ item.title }}"{% endif %}>
                {% if wfFlow %}
                {# Icon per step. Booking (default): create · confirm · arrive · pay · review.
                   Operations: morning · running long · pattern · day closed.
                   Payments: banknote · part-paid · bar chart · settled · day closed.
                   Reports: sunrise · team · alert · trend · download.
                   Discounts: tag · approved · receipt · bar chart.
                   Staff: short · scheduled · arrives · roster.
                   Role-based access: request · approve · all branches · who sees what.
                   Memberships: join · card · receipt · battery low · renew.
                   Packages: box · bag · check · card · eye.
                   Vouchers: gift · card · ticket · half-used · ledger.
                   Campaigns: megaphone · link · live · tag · calendar done.
                   Outreach: rule · scan · approve · send · star.
                   Payroll: banknote · calendar · document · receipt · lock.
                   AI receptionist: settings · phone · chat · calendar check. #}
                <span class="fd-workflow__step-icon" aria-hidden="true">
                  {% if feature.slug == 'operational-visibility' %}
                  {% if loop.index0 == 0 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0-10 0"/><path d="M12 9V2M4.22 10.22l1.42 1.42M1 18h2M21 18h2M18.36 11.64l1.42-1.42M23 22H1M8 5l4-3 4 3"/></svg>
                  {% elif loop.index0 == 1 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M5 3L2 6M22 6l-3-3"/></svg>
                  {% elif loop.index0 == 2 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>
                  {% else %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>{% endif %}
                  {% elif feature.slug == 'ai-assistant' %}

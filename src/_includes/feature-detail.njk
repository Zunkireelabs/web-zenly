  <script>
  (function () {
    var pinWrap = document.querySelector('[data-workflow-scroll]');
    if (!pinWrap) return;
    var cols = pinWrap.querySelectorAll('.fd-workflow__col');
    var panels = pinWrap.querySelectorAll('.fd-workflow__stage-panel');
    if (!cols.length || !panels.length) return;

    var ticking = false;

    function apply() {
      ticking = false;
      var rect = pinWrap.getBoundingClientRect();
      var total = rect.height - window.innerHeight;
      var scrolled = -rect.top;
      var progress = total > 0 ? Math.min(1, Math.max(0, scrolled / total)) : 0;
      var activeIndex = Math.min(cols.length - 1, Math.floor(progress * cols.length));

      cols.forEach(function (col, i) {
        col.classList.toggle('is-active', i === activeIndex);
        col.classList.toggle('is-done', i < activeIndex);
      });
      panels.forEach(function (panel, i) {
        panel.classList.toggle('is-active', i === activeIndex);
      });
    }

    function requestUpdate() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    }

    apply();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  })();

  (function () {
    var showcase = document.querySelector('[data-roles-showcase]');
    if (!showcase) return;
    
    var selectors = showcase.querySelectorAll('[data-role-select]');
    var displayContents = showcase.querySelectorAll('[data-role-content]');
    var accordions = showcase.querySelectorAll('[data-accordion-item]');
    var rotationTimer = null;
    var currentIndex = 0;
    var isUserInteracted = false;
    var duration = 6000; // 6s per role
    var startTime = Date.now();
    var progressAnimFrame = null;
    
    function activateRole(index) {
      currentIndex = index;
      
      // Update desktop selectors
      selectors.forEach(function (card, idx) {
        var isActive = idx === index;
        card.classList.toggle('is-active', isActive);
        
        // Reset progress bar on all bars
        var bar = card.querySelector('.fd-roles-selector-card__progress-bar');
        if (bar) {
          bar.style.width = '0%';
        }
      });
      
      // Update desktop display panel
      displayContents.forEach(function (panel, idx) {
        panel.classList.toggle('is-active', idx === index);
      });
      
      // Update mobile accordions
      accordions.forEach(function (acc, idx) {
        var isActive = idx === index;
        acc.classList.toggle('is-active', isActive);
        var trigger = acc.querySelector('.fd-roles-accordion-trigger');
        if (trigger) {
          trigger.setAttribute('aria-expanded', isActive ? 'true' : 'false');
        }
      });
      
      // Restart progress bar animation if auto-rotation is active
      if (!isUserInteracted) {
        startTime = Date.now();
        animateProgressBar();
      }
    }
    
    function animateProgressBar() {
      if (isUserInteracted) return;
      cancelAnimationFrame(progressAnimFrame);
      
      var activeCard = showcase.querySelector('.fd-roles-selector-card.is-active');
      if (!activeCard) return;
      var bar = activeCard.querySelector('.fd-roles-selector-card__progress-bar');
      if (!bar) return;
      
      function step() {
        if (isUserInteracted) return;
        var now = Date.now();
        var progress = (now - startTime) / duration;
        if (progress >= 1) {
          progress = 1;
          bar.style.width = '100%';
          // Move to next role
          var nextIndex = (currentIndex + 1) % selectors.length;
          activateRole(nextIndex);
        } else {
          bar.style.width = (progress * 100) + '%';
          progressAnimFrame = requestAnimationFrame(step);
        }
      }
      progressAnimFrame = requestAnimationFrame(step);
    }
    
    // Attach event listeners to desktop selector cards
    selectors.forEach(function (card) {
      var index = parseInt(card.getAttribute('data-role-select'), 10);
      card.addEventListener('click', function () {
        isUserInteracted = true;
        cancelAnimationFrame(progressAnimFrame);
        // Clean all progress bars
        selectors.forEach(function (c) {
          var b = c.querySelector('.fd-roles-selector-card__progress-bar');
          if (b) b.style.width = '0%';
        });
        activateRole(index);
      });
    });
    
    // Attach event listeners to mobile accordions
    accordions.forEach(function (acc) {
      var index = parseInt(acc.getAttribute('data-accordion-item'), 10);
      var trigger = acc.querySelector('.fd-roles-accordion-trigger');
      if (trigger) {
        trigger.addEventListener('click', function () {
          isUserInteracted = true;
          cancelAnimationFrame(progressAnimFrame);
          // If already active, toggle it (collapsing all is fine for accordions, or keep one active)
          if (acc.classList.contains('is-active')) {
            // Keep at least one active
          } else {
            activateRole(index);
          }
        });
      }
    });
    
    // Start initial progress animation
    activateRole(0);
  })();

  // Mockup Animations Helper
  (function() {
    // 1. Staff Mockup Animation
    function initStaffAnim(badgeId) {
      var badge = document.getElementById(badgeId);
      if (!badge) return;
      var states = [
        { text: 'Pending', class: 'fd-sch-badge--pending', html: 'Pending' },
        { text: 'Confirmed', class: 'fd-sch-badge--confirmed', html: 'Confirmed' },
        { text: 'In-Progress', class: 'fd-sch-badge--progress', html: '<span class="fd-sch-dot pulsing"></span>In-Progress' }
      ];
      var index = 0;
      setInterval(function() {
        index = (index + 1) % states.length;
        badge.className = 'fd-sch-badge ' + states[index].class;
        badge.innerHTML = states[index].html;
      }, 3000);
    }

    // 2. Manager Mockup Animation
    function initManagerAnim(alertId, successId) {
      var alertEl = document.getElementById(alertId);
      var successEl = document.getElementById(successId);
      if (!alertEl || !successEl) return;
      
      function runCycle() {
        // Step 1: Show conflict, hide success
        alertEl.classList.remove('is-hidden');
        successEl.classList.add('is-hidden');
        
        // Step 2: Auto-resolve after 2.5s
        setTimeout(function() {
          var btn = alertEl.querySelector('.fd-mgr-alert-btn');
          if (btn) btn.style.transform = 'scale(0.95)';
          
          setTimeout(function() {
            if (btn) btn.style.transform = 'none';
            alertEl.classList.add('is-hidden');
            successEl.classList.remove('is-hidden');
          }, 200);
        }, 2500);
      }
      
      runCycle();
      setInterval(runCycle, 6000);
    }

    // 3. Owner Mockup Animation
    function initOwnerAnim(revClass, toastId) {
      var revEls = document.querySelectorAll('.' + revClass);
      var toastEl = document.getElementById(toastId);
      if (!revEls.length || !toastEl) return;

      function runCycle() {
        // Step 1: Reset revenue, hide toast
        revEls.forEach(function(el) { el.textContent = '125,000'; });
        toastEl.classList.add('is-hidden');
        
        // Step 2: After 2s, show completed booking toast, increment revenue
        setTimeout(function() {
          toastEl.classList.remove('is-hidden');
          
          // Animate counter from 125,000 to 129,500
          var start = 125000;
          var end = 129500;
          var current = start;
          var duration = 800; // ms
          var steps = 20;
          var stepVal = (end - start) / steps;
          var stepTime = duration / steps;
          var counterTimer = setInterval(function() {
            current += stepVal;
            if (current >= end) {
              current = end;
              clearInterval(counterTimer);
            }
            var formatted = Math.floor(current).toLocaleString();
            revEls.forEach(function(el) { el.textContent = formatted; });
          }, stepTime);
        }, 2000);
      }
      
      runCycle();
      setInterval(runCycle, 6000);
    }

    // Run animations for the current page
    var slug = '{{ feature.slug }}';
    initStaffAnim('anim-staff-badge-' + slug);
    initStaffAnim('anim-staff-badge-mobile-' + slug);
    initManagerAnim('anim-mgr-alert-' + slug, 'anim-mgr-success-' + slug);
    initManagerAnim('anim-mgr-alert-mobile-' + slug, 'anim-mgr-success-mobile-' + slug);
    initOwnerAnim('anim-own-rev-val-' + slug, 'anim-own-toast-' + slug);
    initOwnerAnim('anim-own-rev-val-mobile-' + slug, 'anim-own-toast-mobile-' + slug);
  })();

  (function () {
    var wrap = document.querySelector('[data-lifecycle-scroll]');
    if (!wrap) return;
    var nums  = wrap.querySelectorAll('.fd-lifecycle-scroll__num');
    var items = wrap.querySelectorAll('.fd-lifecycle-scroll__item');
    if (!nums.length || !items.length) return;

    function update() {
      var viewportCentre = window.innerHeight / 2;
      var activeIndex = 0;
      var minDist = Infinity;
      items.forEach(function (item, i) {
        var r = item.getBoundingClientRect();
        var dist = Math.abs((r.top + r.bottom) / 2 - viewportCentre);
        if (dist < minDist) { minDist = dist; activeIndex = i; }
      });
      items.forEach(function (item, i) { item.classList.toggle('is-active', i === activeIndex); });
      nums.forEach(function (num, i) { num.classList.toggle('is-active', i === activeIndex); });
    }

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();

  (function () {
    var mockup = document.querySelector('[data-hero-mockup]');
    if (!mockup) return;
    var rows = mockup.querySelectorAll('.fd-hero__mockup-row');
    if (!rows.length) return;

    var STATUSES = ['Pending', 'Confirmed', 'In-Progress', 'Completed'];
    var ICONS = {
      'Pending': '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
      'Confirmed': '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
      'In-Progress': '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
      'Completed': '<polyline points="20 6 9 17 4 12"/>'
    };

    function setStatus(row, status) {
      var el = row.querySelector('.fd-hero__mockup-status');
      if (!el) return;
      el.classList.toggle('is-done', status === 'Completed');
      el.innerHTML = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">' + ICONS[status] + '</svg><span>' + status + '</span>';
    }

    var state = [];
    rows.forEach(function (row, i) {
      state[i] = i % STATUSES.length;
      setStatus(row, STATUSES[state[i]]);
    });

    function tick() {
      rows.forEach(function (row, i) {
        state[i] = (state[i] + 1) % STATUSES.length;
        setStatus(row, STATUSES[state[i]]);
      });
    }

    var timer;
    function start() {
      clearInterval(timer);
      timer = setInterval(tick, 2200);
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { start(); io.disconnect(); }
        });
      }, { threshold: 0.3 });
      io.observe(mockup);
    } else {
      start();
    }
  })();

  (function () {
    var mockup = document.querySelector('[data-discount-mockup]');
    if (!mockup) return;
    var statuses = mockup.querySelectorAll('[data-discount-status]');
    if (!statuses.length) return;

    var CHECK_SVG = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    function approve(el) {
      el.classList.add('is-done');
      el.closest('.fd-hero__mockup-tile').classList.add('is-done');
      el.innerHTML = CHECK_SVG + 'Approved';
    }

    function reset(el) {
      el.classList.remove('is-done');
      el.closest('.fd-hero__mockup-tile').classList.remove('is-done');
      el.textContent = 'Pending';
    }

    function runCycle() {
      statuses.forEach(reset);
      statuses.forEach(function (el, i) {
        setTimeout(function () { approve(el); }, 1200 + i * 900);
      });
    }

    var timer;
    function start() {
      runCycle();
      clearInterval(timer);
      timer = setInterval(runCycle, 5000);
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { start(); io.disconnect(); }
        });
      }, { threshold: 0.3 });
      io.observe(mockup);
    } else {
      start();
    }
  })();

  </script>

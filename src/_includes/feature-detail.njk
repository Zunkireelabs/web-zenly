    </div>
  </section>

  <!-- ── FOOTER ───────────────────────────────────────────────────────────── -->
  {% include "_footer-v2.njk" %}

  <script>
  (function () {
    var pinWrap = document.querySelector('[data-workflow-scroll]');
    if (!pinWrap) return;
    var sticky = pinWrap.querySelector('.fd-workflow__sticky');
    var steps = pinWrap.querySelectorAll('.fd-workflow__step');
    var panels = pinWrap.querySelectorAll('.fd-workflow__scene');
    var rail = pinWrap.querySelector('.fd-workflow__rail');
    var fill = pinWrap.querySelector('[data-workflow-fill]');
    var dot = pinWrap.querySelector('[data-workflow-dot]');
    if (!steps.length || !panels.length) return;

    // Not sticky anymore (see main.css) — still grabbed here so it can
    // fade/lift out alongside the mockup in the exit-progress block below.
    var head = document.querySelector('.fd-workflow__head');

    /* Last stretch of the pinned scroll — the whole sticky block blurs and
       fades out so the next section blends in over it, instead of the
       pin releasing abruptly. Shorter window on mobile (0.96 vs 0.9):
       10% of the shorter mobile scroll runway was still a lot of scroll
       distance spent watching the card fade, reading as a big dead gap
       before the next section finally showed up. */
    // The v2 sheet layout (2026-10-19) lets the next rounded section slide
    // over the released pin instead, so the fade-out (which left a blank
    // viewport of cream behind it) is switched off: 1 = never starts.
    var EXIT_START = 1;

    var ticking = false;
    var lastIndex = -1;
    var isList = !!pinWrap.closest('.fd-wf--list');
    var stepsEl = pinWrap.querySelector('.fd-workflow__steps');
    var settleUntil = 0;
    function settle() { apply(); if (performance.now() < settleUntil) requestAnimationFrame(settle); }
    // This section's own scroll listener (below) was running its
    // getBoundingClientRect() + class-toggling work on every scroll frame
    // for the entire rest of the page's life, even long after the user
    // had scrolled past it into later sections — a wasted forced-layout
    // read on every scroll tick site-wide, which is exactly the kind of
    // thing that shows up as general scroll jank/jitter, especially on
    // quick direction reversals. Gate it to only run near this section.
    // No rootMargin buffer: .fd-roles starts immediately after this
    // section with nothing in between, so a generous margin here (50% of
    // a viewport height) kept the listener "active" well into the roles/
    // proof section right after it — the gate never actually closed
    // while scrolling through the section you were testing.
    var isNearView = false;
    var nearViewObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { isNearView = entry.isIntersecting; });
      // A jump (anchor link, click-to-step, fast fling) can land here with no further scroll
      // events, so update as soon as the section becomes visible.
      if (isNearView) requestUpdate();
    });
    nearViewObserver.observe(pinWrap);

    // Flow mode (≥701px): nothing is pinned — the steps scroll natively and the phone column is
    // CSS-sticky. The step whose icon has crossed the viewport middle is active; the rail fill
    // follows the middle line continuously between the first and last icon.
    var isFlow = !!pinWrap.closest('.fd-wf--flow');
    var flowMQ = window.matchMedia('(min-width: 701px)');
    function flowOn() { return isFlow && flowMQ.matches; }
    function iconCenters() {
      return Array.prototype.map.call(steps, function (st) {
        var r = st.querySelector('.fd-workflow__step-icon').getBoundingClientRect();
        return r.top + r.height / 2;
      });
    }
    function flowApply() {
      // Active = the step whose icon is closest to the centre of the viewport.
      var mid = window.innerHeight * 0.5;
      var c = iconCenters();
      var active = 0, best = Infinity;
      c.forEach(function (y, i) { var d = Math.abs(y - mid); if (d < best) { best = d; active = i; } });
      steps.forEach(function (step, i) {
        step.classList.toggle('is-active', i === active);
        step.classList.toggle('is-done', i < active);
      });
      panels.forEach(function (panel, i) { panel.classList.toggle('is-active', i === active); });
      if (rail && fill) {
        var listTop = stepsEl.getBoundingClientRect().top;
        var span = c[c.length - 1] - c[0];
        rail.style.top = (c[0] - listTop) + 'px';
        rail.style.height = span + 'px';
        fill.style.height = Math.min(span, Math.max(0, mid - c[0])) + 'px';
      }
    }

    function apply() {
      ticking = false;
      if (flowOn()) { flowApply(); return; }
      if (isFlow) return; // ≤700px flow mode = stacked per-step phones (script below), nothing to drive
      var rect = pinWrap.getBoundingClientRect();
      var total = rect.height - window.innerHeight;
      var scrolled = -rect.top;
      var progress = total > 0 ? Math.min(1, Math.max(0, scrolled / total)) : 0;
      var activeIndex = Math.min(steps.length - 1, Math.floor(progress * steps.length));

      // List mode: the active step's body expands over ~0.45s, moving the rows the dot/fill
      // are measured against, so re-measure every frame until the expansion has settled.
      if (activeIndex !== lastIndex) { lastIndex = activeIndex; settleUntil = performance.now() + 550; requestAnimationFrame(settle); }
      steps.forEach(function (step, i) {
        step.classList.toggle('is-active', i === activeIndex);
        step.classList.toggle('is-done', i < activeIndex);
      });
      panels.forEach(function (panel, i) {
        panel.classList.toggle('is-active', i === activeIndex);
      });

      if (isList && dot && rail && fill) {
        // Rail runs exactly from the first step's dot to the last step's dot. The fill
        // grows continuously with scroll toward the next step; the dot sits on the active one.
        var listTop = stepsEl.getBoundingClientRect().top;
        var centers = [];
        steps.forEach(function (st) {
          var r = st.querySelector('.fd-workflow__step-row').getBoundingClientRect();
          centers.push(r.top + r.height / 2 - listTop);
        });
        var c0 = centers[0];
        rail.style.top = c0 + 'px';
        rail.style.height = (centers[centers.length - 1] - c0) + 'px';
        var frac = Math.min(1, Math.max(0, progress * steps.length - activeIndex));
        var cur = centers[activeIndex] - c0;
        var next = activeIndex < steps.length - 1 ? centers[activeIndex + 1] - c0 : cur;
        dot.style.top = cur + 'px';
        fill.style.height = (cur + (next - cur) * frac) + 'px';
      } else if (dot && rail) {
        var activeRow = steps[activeIndex].querySelector('.fd-workflow__step-row');
        var railRect = rail.getBoundingClientRect();
        var rowRect = activeRow.getBoundingClientRect();
        var offset = (rowRect.top + rowRect.height / 2) - railRect.top;
        dot.style.top = offset + 'px';
        if (fill) fill.style.height = offset + 'px';
      }

      if (sticky) {
        var exitProgress = progress > EXIT_START ? (progress - EXIT_START) / (1 - EXIT_START) : 0;
        // Fully to 0 opacity (not just faded) and translated up, so the
        // pinned block reads as scrolling away and out of the viewport
        // instead of dissolving into a faint ghost that just sits there.
        var exitLift = (exitProgress * 60).toFixed(1) + 'px';
        sticky.style.opacity = String(1 - exitProgress);
        sticky.style.filter = exitProgress > 0 ? 'blur(' + (exitProgress * 14).toFixed(1) + 'px)' : '';
        sticky.style.transform = exitProgress > 0 ? 'translateY(-' + exitLift + ')' : '';

        // Fade + lift the sticky heading in lockstep with the mockup,
        // instead of it staying sharp while everything below it exits.
        if (head) {
          head.style.opacity = String(1 - exitProgress);
          head.style.filter = exitProgress > 0 ? 'blur(' + (exitProgress * 14).toFixed(1) + 'px)' : '';
          head.style.transform = exitProgress > 0 ? 'translateY(-' + exitLift + ')' : '';
        }
      }
    }

    function requestUpdate() {
      if (ticking || !isNearView) return;
      ticking = true;
      requestAnimationFrame(apply);
    }

    // List mode: clicking (or Enter/Space on) a step scrolls the pinned runway to that step's slice.
    if (pinWrap.closest('.fd-wf--list') || isFlow) {
      steps.forEach(function (step, i) {
        function go() {
          if (flowOn()) {
            // bring this step's icon to the middle of the viewport (where it becomes active)
            var yFlow = window.scrollY + iconCenters()[i] - window.innerHeight * 0.5;
            if (window.__zennlyLenis) window.__zennlyLenis.scrollTo(yFlow); else window.scrollTo({ top: yFlow, behavior: 'smooth' });
            return;
          }
          var top = pinWrap.getBoundingClientRect().top + window.scrollY;
          var total = pinWrap.offsetHeight - window.innerHeight;
          var y = top + total * (i + 0.5) / steps.length;
          if (window.__zennlyLenis) window.__zennlyLenis.scrollTo(y); else window.scrollTo({ top: y, behavior: 'smooth' });
        }
        step.addEventListener('click', go);
        step.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
      });
    }

    apply();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
  })();

  // Flow mode ≤700px (2026-10-21): no pinning — each step gets its own copy of the phone showing
  // just that step's scene, in a white panel under the copy. The panel rises in (site reveal easing)
  // and the scene plays once it scrolls into view. Hidden ≥701px, where the sticky phone is used.
  (function () {
    var wrap = document.querySelector('.fd-wf--flow [data-workflow-scroll]');
    if (!wrap) return;
    var phone = wrap.querySelector('.fd-workflow__layout > .fd-workflow__phone-col');
    if (!phone) return;
    var shots = [];
    wrap.querySelectorAll('.fd-workflow__step').forEach(function (step, i) {
      var shot = document.createElement('div');
      shot.className = 'fd-wf-mshot';
      shot.setAttribute('aria-hidden', 'true');
      var copy = phone.cloneNode(true);
      copy.querySelectorAll('.fd-workflow__scene').forEach(function (scene, j) {
        if (j !== i) scene.remove(); else scene.classList.remove('is-active');
      });
      shot.appendChild(copy);
      step.appendChild(shot);
      shots.push(shot);
    });
    function play(shot) {
      shot.classList.add('is-in');
      var scene = shot.querySelector('.fd-workflow__scene');
      if (scene) setTimeout(function () { scene.classList.add('is-active'); }, 250);
    }
    if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      shots.forEach(play); return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { play(e.target); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -12% 0px' });
    shots.forEach(function (shot) { io.observe(shot); });
  })();

  (function () {
    var showcase = document.querySelector('[data-roles-showcase]');
    if (!showcase) return;
    
    var selectors = showcase.querySelectorAll('[data-role-select]');
    var displayContents = showcase.querySelectorAll('[data-role-content]');
    // .fd-roles-accordion is a SIBLING of showcase now (see feature-detail.njk
    // markup comment), not a descendant — querying it off showcase returned
    // nothing, so no click listeners or scroll observers were ever attached.
    var accordions = document.querySelectorAll('[data-accordion-item]');
    var rotationTimer = null;
    var currentIndex = 0;
    var isUserInteracted = false;
    var duration = 6000; // 6s per role
    var startTime = Date.now();
    var progressAnimFrame = null;
    // Was auto-rotating every 6s in the background even while this section
    // was scrolled off-screen (Date.now()-based timer, not gated on
    // visibility) — scrolling back mid-rotation showed a role you never
    // saw select itself, which read as a flash/glitch. Pause the loop
    // while off-screen and restart it fresh (not from stale elapsed time)
    // once it's back in view.
    var isInView = false;
    
    function activateRole(index) {
      currentIndex = index;
      
      // Update desktop selectors
      selectors.forEach(function (card, idx) {
        var isActive = idx === index;
        card.classList.toggle('is-active', isActive);
        var bar = card.querySelector('.fd-roles-selector-card__progress-bar');
        if (bar) bar.style.transform = 'scaleX(0)';
      });
      
      // Update desktop display panel
      displayContents.forEach(function (panel, idx) {
        panel.classList.toggle('is-active', idx === index);
      });
      
      // Update mobile accordions
      accordions.forEach(function (acc, idx) {
        var isActive = idx === index;
        acc.classList.toggle('is-active', isActive);
        var trigger = acc.querySelector('.fd-roles-accordion-trigger');
        if (trigger) {
          trigger.setAttribute('aria-expanded', isActive ? 'true' : 'false');
        }
      });
      
      // Restart progress bar animation if auto-rotation is active
      if (!isUserInteracted) {
        startTime = Date.now();
        animateProgressBar();
      }
    }
    
    function animateProgressBar() {
      if (isUserInteracted || !isInView) return;
      cancelAnimationFrame(progressAnimFrame);

      var activeCard = showcase.querySelector('.fd-roles-selector-card.is-active');
      if (!activeCard) return;
      var bar = activeCard.querySelector('.fd-roles-selector-card__progress-bar');

      function step() {
        if (isUserInteracted || !isInView) return;
        var now = Date.now();
        var progress = (now - startTime) / duration;
        if (progress >= 1) {
          if (bar) bar.style.transform = 'scaleX(1)';
          // Move to next role
          var nextIndex = (currentIndex + 1) % selectors.length;
          activateRole(nextIndex);
        } else {
          if (bar) bar.style.transform = 'scaleX(' + progress + ')';
          progressAnimFrame = requestAnimationFrame(step);
        }
      }
      progressAnimFrame = requestAnimationFrame(step);
    }
    
    // Attach event listeners to desktop selector cards
    selectors.forEach(function (card) {
      var index = parseInt(card.getAttribute('data-role-select'), 10);
      card.addEventListener('click', function () {
        // Jump straight to this tab but keep the auto-advancing line going
        // (matches the homepage outcomes tabs) rather than freezing it.
        cancelAnimationFrame(progressAnimFrame);
        activateRole(index);
      });
    });
    
    // Attach event listeners to mobile accordions
    var lastManualTapAt = 0;
    accordions.forEach(function (acc) {
      var index = parseInt(acc.getAttribute('data-accordion-item'), 10);
      var trigger = acc.querySelector('.fd-roles-accordion-trigger');
      if (trigger) {
        trigger.addEventListener('click', function () {
          lastManualTapAt = Date.now();
          cancelAnimationFrame(progressAnimFrame);
          // If already active, toggle it (collapsing all is fine for accordions, or keep one active)
          if (acc.classList.contains('is-active')) {
            // Keep at least one active
          } else {
            activateRole(index);
          }
        });
      }
    });

    // Swipe on the display panel to switch roles on mobile. The desktop
    // showcase (fd-tabs + fd-roles-display-panel) stays visible on .fd-page
    // templates at every width (see fd-roles-showcase override in
    // main.css), so phones see this tab strip + panel, not the accordion —
    // and the tab strip itself is a thin auto-scrolling row, an unreliable
    // touch target, so the panel content is the real swipe surface.
    var displayPanel = showcase.querySelector('.fd-roles-display-panel');
    if (displayPanel) {
      var rtx0 = 0, rty0 = 0, rTracking = false, rHorizontal = false;
      displayPanel.addEventListener('touchstart', function (e) {
        if (e.touches.length !== 1) return;
        rtx0 = e.touches[0].clientX; rty0 = e.touches[0].clientY;
        rTracking = true; rHorizontal = false;
      }, { passive: true });
      displayPanel.addEventListener('touchmove', function (e) {
        if (!rTracking) return;
        var dx = e.touches[0].clientX - rtx0, dy = e.touches[0].clientY - rty0;
        if (!rHorizontal && Math.abs(dx) > 10 && Math.abs(dx) > Math.abs(dy)) rHorizontal = true;
        if (rHorizontal && e.cancelable) e.preventDefault();
      }, { passive: false });
      displayPanel.addEventListener('touchend', function (e) {
        if (!rTracking) return;
        rTracking = false;
        if (!rHorizontal) return;
        var dx = e.changedTouches[0].clientX - rtx0;
        if (Math.abs(dx) < 40) return;
        cancelAnimationFrame(progressAnimFrame);
        var n = (currentIndex + (dx < 0 ? 1 : -1) + selectors.length) % selectors.length;
        activateRole(n);
        selectors[n].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      });
    }

    // Auto-expand each accordion item as it scrolls near the vertical
    // center of the viewport — on top of (not instead of) the tap-to-
    // expand above, so both scrolling and tapping control which role is
    // open. rootMargin shrinks the observed area to a thin band around
    // the center, so an item only "activates" once it's actually being
    // read, not the instant it appears at the bottom edge.
    var accordionScrollObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        // Don't fight a tap that just happened (e.g. the item the user
        // tapped is still crossing the center band as it expands).
        if (Date.now() - lastManualTapAt < 600) return;
        var idx = parseInt(entry.target.getAttribute('data-accordion-item'), 10);
        if (idx !== currentIndex) activateRole(idx);
      });
    }, { threshold: 0, rootMargin: '-45% 0px -45% 0px' });
    accordions.forEach(function (acc) { accordionScrollObserver.observe(acc); });

    // Start initial progress animation
    activateRole(0);

    // Gate the auto-rotation on actual visibility (see isInView above).
    var roleVisibilityObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        isInView = entry.isIntersecting;
        if (isInView && !isUserInteracted) {
          startTime = Date.now();
          animateProgressBar();
        } else {
          cancelAnimationFrame(progressAnimFrame);
        }
      });
    }, { threshold: 0.3 });
    roleVisibilityObserver.observe(showcase);
  })();

  // Mockup Animations Helper
  (function() {
    // 1. Staff Mockup Animation
    function initStaffAnim(badgeId) {
      var badge = document.getElementById(badgeId);
      if (!badge) return;
      var states = [
        { text: 'Pending', class: 'fd-sch-badge--pending', html: 'Pending' },
        { text: 'Confirmed', class: 'fd-sch-badge--confirmed', html: 'Confirmed' },
        { text: 'In-Progress', class: 'fd-sch-badge--progress', html: '<span class="fd-sch-dot pulsing"></span>In-Progress' }
      ];
      var index = 0;
      setInterval(function() {
        index = (index + 1) % states.length;
        badge.className = 'fd-sch-badge ' + states[index].class;
        badge.innerHTML = states[index].html;
      }, 3000);
    }

    // 2. Manager Mockup Animation
    function initManagerAnim(alertId, successId) {
      var alertEl = document.getElementById(alertId);
      var successEl = document.getElementById(successId);
      if (!alertEl || !successEl) return;
      
      function runCycle() {
        // Step 1: Show conflict, hide success
        alertEl.classList.remove('is-hidden');
        successEl.classList.add('is-hidden');
        
        // Step 2: Auto-resolve after 2.5s
        setTimeout(function() {
          var btn = alertEl.querySelector('.fd-mgr-alert-btn');
          if (btn) btn.style.transform = 'scale(0.95)';
          
          setTimeout(function() {
            if (btn) btn.style.transform = 'none';
            alertEl.classList.add('is-hidden');
            successEl.classList.remove('is-hidden');
          }, 200);
        }, 2500);
      }
      
      runCycle();
      setInterval(runCycle, 6000);
    }

    // 3. Owner Mockup Animation
    function initOwnerAnim(revClass, toastId) {
      var revEls = document.querySelectorAll('.' + revClass);
      var toastEl = document.getElementById(toastId);
      if (!revEls.length || !toastEl) return;
      var from = +(revEls[0].dataset.from || 3320);
      var to = +(revEls[0].dataset.to || 3440);

      function runCycle() {
        // Step 1: Reset revenue, hide toast
        revEls.forEach(function(el) { el.textContent = from.toLocaleString(); });
        toastEl.classList.add('is-hidden');
        
        // Step 2: After 2s, show completed booking toast, increment revenue
        setTimeout(function() {
          toastEl.classList.remove('is-hidden');
          
          // Animate the counter from data-from to data-to (generic mockup: 3,320 → 3,440)
          var start = from;
          var end = to;
          var current = start;
          var duration = 800; // ms
          var steps = 20;
          var stepVal = (end - start) / steps;
          var stepTime = duration / steps;
          var counterTimer = setInterval(function() {
            current += stepVal;
            if (current >= end) {
              current = end;
              clearInterval(counterTimer);
            }
            var formatted = Math.floor(current).toLocaleString();
            revEls.forEach(function(el) { el.textContent = formatted; });
          }, stepTime);
        }, 2000);
      }
      
      runCycle();
      setInterval(runCycle, 6000);
    }

    // Run animations for the current page
    var slug = '{{ feature.slug }}';
    initStaffAnim('anim-staff-badge-' + slug);
    initStaffAnim('anim-staff-badge-mobile-' + slug);
    initManagerAnim('anim-mgr-alert-' + slug, 'anim-mgr-success-' + slug);
    initManagerAnim('anim-mgr-alert-mobile-' + slug, 'anim-mgr-success-mobile-' + slug);
    initOwnerAnim('anim-own-rev-val-' + slug, 'anim-own-toast-' + slug);
    initOwnerAnim('anim-own-rev-val-mobile-' + slug, 'anim-own-toast-mobile-' + slug);
  })();

  (function () {
    var wrap = document.querySelector('[data-lifecycle-scroll]');
    if (!wrap) return;
    var nums  = wrap.querySelectorAll('.fd-lifecycle-scroll__num');
    var items = wrap.querySelectorAll('.fd-lifecycle-scroll__item');
    if (!nums.length || !items.length) return;

    function update() {
      var viewportCentre = window.innerHeight / 2;
      var activeIndex = 0;
      var minDist = Infinity;
      items.forEach(function (item, i) {
        var r = item.getBoundingClientRect();
        var dist = Math.abs((r.top + r.bottom) / 2 - viewportCentre);
        if (dist < minDist) { minDist = dist; activeIndex = i; }
      });
      items.forEach(function (item, i) { item.classList.toggle('is-active', i === activeIndex); });
      nums.forEach(function (num, i) { num.classList.toggle('is-active', i === activeIndex); });
    }

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();

  (function () {
    var mockup = document.querySelector('[data-hero-mockup]');
    if (!mockup) return;
    var rows = mockup.querySelectorAll('.fd-hero__mockup-row');
    if (!rows.length) return;

    var STATUSES = ['Pending', 'Confirmed', 'In-Progress', 'Completed'];
    var ICONS = {
      'Pending': '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
      'Confirmed': '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
      'In-Progress': '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
      'Completed': '<polyline points="20 6 9 17 4 12"/>'
    };

    function setStatus(row, status) {
      var el = row.querySelector('.fd-hero__mockup-status');
      if (!el) return;
      el.classList.toggle('is-done', status === 'Completed');
      el.innerHTML = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">' + ICONS[status] + '</svg><span>' + status + '</span>';
    }

    var state = [];
    rows.forEach(function (row, i) {
      state[i] = i % STATUSES.length;
      setStatus(row, STATUSES[state[i]]);
    });

    function tick() {
      rows.forEach(function (row, i) {
        state[i] = (state[i] + 1) % STATUSES.length;
        setStatus(row, STATUSES[state[i]]);
      });
    }

    var timer;
    function start() {
      clearInterval(timer);
      timer = setInterval(tick, 2200);
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { start(); io.disconnect(); }
        });
      }, { threshold: 0.3 });
      io.observe(mockup);
    } else {
      start();
    }
  })();

  (function () {
    var mockup = document.querySelector('[data-discount-mockup]');
    if (!mockup) return;
    var statuses = mockup.querySelectorAll('[data-discount-status]');
    if (!statuses.length) return;

    var CHECK_SVG = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';

    function approve(el) {
      el.classList.add('is-done');
      el.closest('.fd-hero__mockup-tile').classList.add('is-done');
      el.innerHTML = CHECK_SVG + 'Approved';
    }

    function reset(el) {
      el.classList.remove('is-done');
      el.closest('.fd-hero__mockup-tile').classList.remove('is-done');
      el.textContent = 'Pending';
    }

    function runCycle() {
      statuses.forEach(reset);
      statuses.forEach(function (el, i) {
        setTimeout(function () { approve(el); }, 1200 + i * 900);
      });
    }

    var timer;
    function start() {
      runCycle();
      clearInterval(timer);
      timer = setInterval(runCycle, 5000);
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { start(); io.disconnect(); }
        });
      }, { threshold: 0.3 });
      io.observe(mockup);
    } else {
      start();
    }
  })();

  </script>
</main>

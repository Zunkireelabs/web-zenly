                <span class="fd-hero__mockup-avatar">A</span>
                <div class="fd-hero__mockup-info">
                  <p class="fd-hero__mockup-name">Admin</p>
                  <p class="fd-hero__mockup-service">All branches &middot; full visibility</p>
                </div>
                <span class="fd-hero__mockup-status is-done">Full access</span>
              </div>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">M</span>

              </div>
              <span class="fd-hero__mockup-live"><span class="live-dot"></span>Live</span>
            </div>
            <div class="fd-hero__mockup-list" data-hero-mockup>
              <div class="fd-hero__mockup-row">
                <span class="fd-hero__mockup-avatar">M</span>
                <div class="fd-hero__mockup-info">

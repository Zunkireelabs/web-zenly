                    {% set isDiscountRequestForm = feature.slug == "discount-management" and loop.index0 == 0 %}
                    {% set isDiscountReviewForm = feature.slug == "discount-management" and loop.index0 == 1 %}
                    {% set isDiscountAppliedForm = feature.slug == "discount-management" and loop.index0 == 2 %}
                    {% set isDiscountReportForm = feature.slug == "discount-management" and loop.index0 == 3 %}
                    {% set isBookingCreate = feature.slug == "booking" and loop.index0 == 0 %}
                    {% set isBookingConfirm = feature.slug == "booking" and loop.index0 == 1 %}
                    {% set isBookingLive = feature.slug == "booking" and loop.index0 == 2 %}
                    {% set isBookingClosed = feature.slug == "booking" and loop.index0 == 3 %}
                    {% set isBookingDay = feature.slug == "booking" and loop.index0 == 4 %}
                    {% set isPayFull = feature.slug == "payment-tracking" and loop.index0 == 0 %}
                    {% set isPayPartial = feature.slug == "payment-tracking" and loop.index0 == 1 %}
                    {% set isPayManagerTotal = feature.slug == "payment-tracking" and loop.index0 == 2 %}
                    {% set isPaySettled = feature.slug == "payment-tracking" and loop.index0 == 3 %}
                    {% set isPayOwner = feature.slug == "payment-tracking" and loop.index0 == 4 %}
                    {% set isReportsYesterday = feature.slug == "reports" and loop.index0 == 0 %}
                    {% set isReportsStaff = feature.slug == "reports" and loop.index0 == 1 %}
                    {% set isReportsFlag = feature.slug == "reports" and loop.index0 == 2 %}
                    {% set isReportsCompare = feature.slug == "reports" and loop.index0 == 3 %}
                    {% set isReportsExport = feature.slug == "reports" and loop.index0 == 4 %}
                    {% set isStaffNeed = feature.slug == "staff-management" and loop.index0 == 0 %}
                    {% set isStaffScheduled = feature.slug == "staff-management" and loop.index0 == 1 %}
                    {% set isStaffEffective = feature.slug == "staff-management" and loop.index0 == 2 %}
                    {% set isStaffRoster = feature.slug == "staff-management" and loop.index0 == 3 %}
                    {% set isOpsMorning = feature.slug == "operational-visibility" and loop.index0 == 0 %}

  <script>
  (function () {
    var grid = document.querySelector('.fd-workflow__grid');
    if (!grid) return;
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) {
        grid.classList.add('is-visible');
        io.disconnect();
      }
    }, { threshold: 0.15 });
    io.observe(grid);
  })();

  (function () {
    var wrap = document.querySelector('[data-roles-tabs]');
    if (!wrap) return;
    var tabs = wrap.querySelectorAll('[data-role-tab]');
    var panels = wrap.querySelectorAll('[data-role-panel]');
    function activate(index) {
      tabs.forEach(function (t) { t.classList.toggle('is-active', t.getAttribute('data-role-tab') === index); });
      panels.forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-role-panel') === index); });
    }
    tabs.forEach(function (tab) {
      var index = tab.getAttribute('data-role-tab');
      tab.addEventListener('mouseenter', function () { activate(index); });
      tab.addEventListener('click', function () { activate(index); });
      tab.addEventListener('focus', function () { activate(index); });
    });
  })();

  (function () {
    var mockup = document.querySelector('[data-bento-mockup]');
    if (!mockup) return;
    var rows  = mockup.querySelectorAll('.fd-bento__mockup-row');
    var cards = document.querySelectorAll('.fd-bento__card');
    if (!rows.length || !cards.length) return;

    var i = 0;
    var timer;

    function activate(index) {
      rows.forEach(function (row) {
        row.classList.toggle('is-active', row.getAttribute('data-mockup-row') === String(index + 1));
      });
      cards.forEach(function (card) {
        card.classList.toggle('is-linked', card.classList.contains('fd-bento__card--' + (index + 1)));
      });
    }

    function tick() {
      activate(i);
      i = (i + 1) % rows.length;
    }

    function start() {
      tick();
      clearInterval(timer);
      timer = setInterval(tick, 1800);
    }

    var section = document.querySelector('.fd-connected');
    if (section && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { start(); io.disconnect(); }
        });
      }, { threshold: 0.3 });
      io.observe(section);
    } else {
      start();
    }
  })();

  (function () {
    var wrap = document.querySelector('[data-lifecycle-scroll]');
    if (!wrap) return;
    var nums  = wrap.querySelectorAll('.fd-lifecycle-scroll__num');
    var items = wrap.querySelectorAll('.fd-lifecycle-scroll__item');
    if (!nums.length || !items.length) return;

    function update() {
      var viewportCentre = window.innerHeight / 2;
      var activeIndex = 0;
      var minDist = Infinity;
      items.forEach(function (item, i) {
        var r = item.getBoundingClientRect();
        var dist = Math.abs((r.top + r.bottom) / 2 - viewportCentre);
        if (dist < minDist) { minDist = dist; activeIndex = i; }
      });
      items.forEach(function (item, i) { item.classList.toggle('is-active', i === activeIndex); });
      nums.forEach(function (num, i) { num.classList.toggle('is-active', i === activeIndex); });
    }

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();

  (function () {
    var mockup = document.querySelector('[data-hero-mockup]');
    if (!mockup) return;
    var rows = mockup.querySelectorAll('.fd-hero__mockup-row');
    if (!rows.length) return;

    var STATUSES = ['Pending', 'Confirmed', 'In-Progress', 'Completed'];
    var ICONS = {
      'Pending': '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
      'Confirmed': '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>',
      'In-Progress': '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
      'Completed': '<polyline points="20 6 9 17 4 12"/>'
    };

    function setStatus(row, status) {
      var el = row.querySelector('.fd-hero__mockup-status');
      if (!el) return;
      el.classList.toggle('is-done', status === 'Completed');
      el.innerHTML = '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">' + ICONS[status] + '</svg><span>' + status + '</span>';
    }

    var state = [];
    rows.forEach(function (row, i) {
      state[i] = i % STATUSES.length;
      setStatus(row, STATUSES[state[i]]);
    });

    function tick() {
      rows.forEach(function (row, i) {
        state[i] = (state[i] + 1) % STATUSES.length;
        setStatus(row, STATUSES[state[i]]);
      });
    }

    var timer;
    function start() {
      clearInterval(timer);
      timer = setInterval(tick, 2200);
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { start(); io.disconnect(); }
        });
      }, { threshold: 0.3 });
      io.observe(mockup);
    } else {
      start();
    }
  })();

  </script>
</main>

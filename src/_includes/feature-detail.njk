  <!-- ── TRUST CAROUSEL ─────────────────────────────────────────────────── -->
  <section class="fd-trust">
    <p class="fd-trust__heading"><span class="fd-trust__stat">Trusted by</span> appointment businesses worldwide.</p>
    <div class="fd-trust__track" id="fdTrustTrack">
      <div class="fd-trust__rail" id="fdTrustRail">
            <div class="trust-chip trust-chip--live">Nuad Thai Spa</div>
            <div class="trust-chip trust-chip--light-italic">Pure Glow</div>
            <div class="trust-chip trust-chip--caps">The Curl Studio</div>
            <div class="trust-chip trust-chip--medium">SmileWell</div>
            <div class="trust-chip trust-chip--bold">FitForm</div>
            <div class="trust-chip trust-chip--dot">revive.</div>
            <div class="trust-chip trust-chip--medium">Ink &amp; Canvas</div>
            <div class="trust-chip trust-chip--wide-caps">PHYSIO PLUS</div>
            <div class="trust-chip trust-chip--dot">clean &amp; co.</div>
            <div class="trust-chip trust-chip--serif-italic">nail atelier</div>
            <div class="trust-chip trust-chip--caps">ZENITH DENTAL</div>
            <div class="trust-chip trust-chip--serif">maven</div>
            <div class="trust-chip trust-chip--heavy">FLEX</div>
            <div class="trust-chip trust-chip--medium">The Tidiers</div>
            <div class="trust-chip trust-chip--light-italic">bloom studio</div>
            <!-- Duplicate for seamless loop -->
            <div class="trust-chip trust-chip--live">Nuad Thai Spa</div>
            <div class="trust-chip trust-chip--light-italic">Pure Glow</div>
            <div class="trust-chip trust-chip--caps">The Curl Studio</div>
            <div class="trust-chip trust-chip--medium">SmileWell</div>
            <div class="trust-chip trust-chip--bold">FitForm</div>
            <div class="trust-chip trust-chip--dot">revive.</div>
            <div class="trust-chip trust-chip--medium">Ink &amp; Canvas</div>
            <div class="trust-chip trust-chip--wide-caps">PHYSIO PLUS</div>
            <div class="trust-chip trust-chip--dot">clean &amp; co.</div>
            <div class="trust-chip trust-chip--serif-italic">nail atelier</div>
            <div class="trust-chip trust-chip--caps">ZENITH DENTAL</div>
            <div class="trust-chip trust-chip--serif">maven</div>
            <div class="trust-chip trust-chip--heavy">FLEX</div>
            <div class="trust-chip trust-chip--medium">The Tidiers</div>
            <div class="trust-chip trust-chip--light-italic">bloom studio</div>
      </div>
    </div>
  </section>

  <!-- ── THE PROBLEM ───────────────────────────────────────────────────── -->
  {% if feature.problem %}
  <section class="section fd-problem">
    <div class="section__inner">
      <div class="section__header reveal">
        <h2 class="section__h2">{{ feature.problem.headline | safe }}</h2>
      </div>
      {% if feature.problem.body %}
      <p class="fd-problem__body reveal">{{ feature.problem.body }}</p>
      {% endif %}
      {% if feature.problem.panels %}
      <div class="fd-problem__grid reveal">
        {% for panel in feature.problem.panels %}
        <div class="fd-problem__card">
          <span class="fd-problem__emoji" aria-hidden="true">{{ panel.emoji }}</span>
          <h3 class="fd-problem__title">{{ panel.title }}</h3>
          <p class="fd-problem__text">{{ panel.body }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <!-- ── LIFECYCLE (sticky numbered scroll) ─────────────────────────────────
       Skipped when feature.workflow is present — that timeline already
       covers the same status walkthrough with more concrete detail. ── -->
  {% if not feature.workflow %}
  <section class="section fd-lifecycle">
    <div class="section__inner">
      <div class="section__header reveal">
        <h2 class="section__h2">{{ feature.intro.headline if feature.intro else "Here's how it happens" }}</h2>
        {% if feature.intro.body %}
        <p class="section__sub">{{ feature.intro.body }}</p>
        {% endif %}
      </div>
      <div class="fd-lifecycle-scroll" data-lifecycle-scroll>
        <div class="fd-lifecycle-scroll__nums">
          {% for item in feature.howItWorks %}
          <div class="fd-lifecycle-scroll__num{% if loop.first %} is-active{% endif %}">{{ item.step }}</div>
          {% endfor %}
        </div>
        <div class="fd-lifecycle-scroll__text-col">
          {% for item in feature.howItWorks %}
          <div class="fd-lifecycle-scroll__item{% if loop.first %} is-active{% endif %}">
            <div class="fd-lifecycle-scroll__card">
              <h3 class="fd-lifecycle-scroll__title">{{ item.title }}</h3>
              <p class="fd-lifecycle-scroll__desc">{{ item.description }}</p>
            </div>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- ── WORKFLOW TIMELINE ─────────────────────────────────────────────── -->
  {% if feature.workflow %}
  <section class="fd-workflow">
    <div class="section__inner">
      <div class="fd-workflow__pin-wrap" data-workflow-scroll style="--wf-steps: {{ feature.workflow | length }}">
        <div class="fd-workflow__sticky">
          <div class="fd-workflow__head">
            <h2 class="fd-workflow__heading">{{ feature.workflowHeading | safe if feature.workflowHeading else "How a booking day runs on <span class=\"fd-workflow__heading-accent\">Zenly.</span>" | safe }}</h2>

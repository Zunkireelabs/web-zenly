            </div>
            <div class="fd-hero__mockup-grid" data-discount-mockup>
              <div class="fd-hero__mockup-tile" data-discount-item>
                <div class="fd-hero__mockup-tile-top">
                  <span class="fd-hero__mockup-avatar">M</span>
                  <span class="fd-hero__mockup-status" data-discount-status>Pending</span>
                </div>

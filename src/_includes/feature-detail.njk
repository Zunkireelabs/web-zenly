                  {% if loop.index0 == 0 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                  {% elif loop.index0 == 1 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3v18"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"/></svg>
                  {% elif loop.index0 == 2 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M8 17v-5M13 17V8M18 17v-8"/></svg>
                  {% elif loop.index0 == 3 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                  {% else %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>{% endif %}
                  {% elif loop.index0 == 0 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"/></svg>
                  {% elif loop.index0 == 1 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                  {% elif loop.index0 == 2 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
                  {% elif loop.index0 == 3 %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 2v20l3-2 3 2 3-2 3 2V2l-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg>
                  {% else %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>{% endif %}
                </span>
                {% endif %}
                <span class="fd-workflow__step-time">{{ item.time }}</span>
                <div class="fd-workflow__step-row">
                  <h3 class="fd-workflow__step-title">{{ item.title }}</h3>
                  <span class="fd-workflow__step-tag">( {{ item.num }} )</span>
                </div>
                <p class="fd-workflow__step-body">{{ item.body }}</p>
              </div>
              {% endfor %}
            </div>

            {% if not (wfList or wfFlow) %}
            <div class="fd-workflow__rail" aria-hidden="true">
              <span class="fd-workflow__rail-fill" data-workflow-fill></span>
              <span class="fd-workflow__rail-dot" data-workflow-dot></span>
            </div>
            {% endif %}

            <div class="fd-workflow__phone-col">
              <div class="fd-workflow__phone">
                <div class="fd-workflow__phone-media">
                  <div class="fd-workflow__phone-statusbar">
                    <span>9:41</span>
                    <span class="fd-workflow__phone-statusbar-icons">
                      <svg width="14" height="10" viewBox="0 0 14 10" fill="none"><rect x="0" y="6" width="2.5" height="4" rx="0.5" fill="currentColor"/><rect x="4" y="4" width="2.5" height="6" rx="0.5" fill="currentColor"/><rect x="8" y="2" width="2.5" height="8" rx="0.5" fill="currentColor"/><rect x="11.5" y="0" width="2.5" height="10" rx="0.5" fill="currentColor" opacity="0.35"/></svg>
                      <svg width="18" height="10" viewBox="0 0 18 10" fill="none"><rect x="0.5" y="0.5" width="15" height="9" rx="2" stroke="currentColor"/><rect x="2" y="2" width="10" height="6" rx="1" fill="currentColor"/><rect x="16" y="3" width="1.5" height="4" rx="0.5" fill="currentColor"/></svg>
                    </span>
                  </div>

                  <!-- Constant app chrome — just the header; the schedule rows that used
                       to sit here never changed across steps, so they've been dropped
                       in favor of the step scenes actually filling the screen. -->
                  <div class="fd-workflow__app-header">
                    <span class="fd-workflow__app-header-title">Today</span>
                    <span class="fd-workflow__phone-wordmark">Zennly</span>
                  </div>

                  <!-- The part that actually cross-fades per step — one of three real
                       app-screen scenes (not a repeat of the left-column copy), chosen
                       by what the step is actually about: a dashboard/report check-in,
                       a completed/settled confirmation, or a live notification. -->
                  <div class="fd-workflow__phone-stage">
                    {% for item in feature.workflow %}
                    {% set lowerBody = item.body | lower %}
                    {% set isDashboard = ("dashboard" in lowerBody) or ("report" in lowerBody) or ("revenue" in lowerBody) or ("compare" in lowerBody) or ("exported" in lowerBody) or ("trend" in lowerBody) %}
                    {% set isSuccess = (item.status == "Completed" or item.status == "Reconciled") and not isDashboard %}
                    {% set isDiscountRequestForm = feature.slug == "discount-management" and loop.index0 == 0 %}
                    {% set isDiscountReviewForm = feature.slug == "discount-management" and loop.index0 == 1 %}
                    {% set isDiscountAppliedForm = feature.slug == "discount-management" and loop.index0 == 2 %}
                    {% set isDiscountReportForm = feature.slug == "discount-management" and loop.index0 == 3 %}
                    {% set isBookingCreate = feature.slug == "booking" and loop.index0 == 0 %}
                    {% set isBookingConfirm = feature.slug == "booking" and loop.index0 == 1 %}
                    {% set isBookingLive = feature.slug == "booking" and loop.index0 == 2 %}
                    {% set isBookingClosed = feature.slug == "booking" and loop.index0 == 3 %}
                    {% set isBookingDay = feature.slug == "booking" and loop.index0 == 4 %}
                    {% set isPayFull = feature.slug == "payment-tracking" and loop.index0 == 0 %}
                    {% set isPayPartial = feature.slug == "payment-tracking" and loop.index0 == 1 %}
                    {% set isPayManagerTotal = feature.slug == "payment-tracking" and loop.index0 == 2 %}
                    {% set isPaySettled = feature.slug == "payment-tracking" and loop.index0 == 3 %}
                    {% set isPayOwner = feature.slug == "payment-tracking" and loop.index0 == 4 %}
                    {% set isReportsYesterday = feature.slug == "reports" and loop.index0 == 0 %}
                    {% set isReportsStaff = feature.slug == "reports" and loop.index0 == 1 %}
                    {% set isReportsFlag = feature.slug == "reports" and loop.index0 == 2 %}
                    {% set isReportsCompare = feature.slug == "reports" and loop.index0 == 3 %}
                    {% set isReportsExport = feature.slug == "reports" and loop.index0 == 4 %}
                    {% set isStaffNeed = feature.slug == "staff-management" and loop.index0 == 0 %}
                    {% set isStaffScheduled = feature.slug == "staff-management" and loop.index0 == 1 %}
                    {% set isStaffEffective = feature.slug == "staff-management" and loop.index0 == 2 %}
                    {% set isStaffRoster = feature.slug == "staff-management" and loop.index0 == 3 %}
                    {% set isOpsMorning = feature.slug == "operational-visibility" and loop.index0 == 0 %}
                    {% set isOpsRunningLong = feature.slug == "operational-visibility" and loop.index0 == 1 %}
                    {% set isOpsPattern = feature.slug == "operational-visibility" and loop.index0 == 2 %}
                    {% set isOpsDayCloses = feature.slug == "operational-visibility" and loop.index0 == 3 %}

                    {% if item.scene and item.scene.type == "form" %}
                    <div class="fd-workflow__scene fd-workflow__scene--form{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__form">
                        <div class="fd-workflow__form-head">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                          <span>{{ item.scene.head }}</span>
                        </div>
                        <div class="fd-workflow__form-banner">
                          <span class="fd-workflow__form-banner-icon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg></span>
                          <div>
                            <p class="fd-workflow__form-banner-title">{{ item.scene.bannerTitle }}</p>
                            <p class="fd-workflow__form-banner-sub">{{ item.scene.bannerSub }}</p>
                          </div>
                        </div>
                        {% for f in item.scene.fields %}
                        {% if f[0] is string %}
                        <div class="fd-workflow__form-field">
                          <span class="fd-workflow__form-label">{{ f[0] }}</span>
                          <div class="fd-workflow__form-select"><span>{{ f[1] }}</span><svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                        </div>
                        {% else %}
                        <div class="fd-workflow__form-row">
                          {% for g in f %}
                          <div class="fd-workflow__form-field">
                            <span class="fd-workflow__form-label">{{ g[0] }}</span>
                            <div class="fd-workflow__form-select"><span>{{ g[1] }}</span><svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
                          </div>
                          {% endfor %}
                        </div>
                        {% endif %}
                        {% endfor %}
                        <button class="fd-workflow__form-submit" type="button">{{ item.scene.submit }}<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg></button>
                      </div>
                    </div>
                    {% elif item.scene and item.scene.type == "review" %}
                    <div class="fd-workflow__scene fd-workflow__scene--form{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__review">
                        <div class="fd-workflow__notif fd-workflow__review-notif">
                          <div class="fd-workflow__notif-head">
                            <span class="fd-workflow__notif-logo">Z</span>
                            <span class="fd-workflow__notif-app">Zennly</span>
                            <span class="fd-workflow__notif-time fd-workflow__notif-time--plain">{{ item.scene.notifTime or "Just now" }}</span>
                          </div>
                          <div class="fd-workflow__notif-body"><strong>{{ item.scene.notif or item.title }}</strong></div>
                          <div class="fd-workflow__notif-foot">
                            <span class="fd-workflow__phone-badge fd-workflow__phone-badge--{{ item.scene.badgeClass or "pending" }}">{{ item.scene.badge }}</span>
                          </div>
                        </div>
                        <span class="fd-workflow__review-label">{{ item.scene.label }}</span>
                        <div class="fd-workflow__review-card">
                          <div class="fd-workflow__review-row">
                            <span class="fd-workflow__review-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                            <div class="fd-workflow__review-field">
                              <span class="fd-workflow__review-field-label">{{ item.scene.rowLabel }}</span>
                              <span class="fd-workflow__review-field-value">{{ item.scene.rowValue }}</span>
                            </div>
                          </div>
                          <div class="fd-workflow__review-field fd-workflow__review-field--plain">
                            <span class="fd-workflow__review-field-label">{{ item.scene.plainLabel }}</span>
                            <span class="fd-workflow__review-field-value">{{ item.scene.plainValue }}</span>
                          </div>
                        </div>
                        <button class="fd-workflow__form-submit" type="button"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{{ item.scene.button }}</button>
                      </div>
                    </div>
                    {% elif item.scene and item.scene.type == "live" %}
                    <div class="fd-workflow__scene{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__live">
                        <div class="fd-workflow__live-card">
                          <div class="fd-workflow__live-top">
                            <span class="fd-sch-dot pulsing"></span>
                            <span class="fd-workflow__live-label">{{ item.scene.label }}</span>
                            <span class="fd-workflow__notif-time fd-workflow__notif-time--plain">{{ item.scene.time }}</span>
                          </div>
                          <p class="fd-workflow__live-title">{{ item.scene.title }}</p>
                          <p class="fd-workflow__live-sub">{{ item.scene.sub }}</p>
                        </div>
                        <div class="fd-workflow__live-steps">
                          {% for s in item.scene.steps %}
                          <div class="fd-workflow__live-step{% if s[1] %} is-{{ s[1] }}{% endif %}"><span></span>{{ s[0] }}</div>
                          {% endfor %}
                        </div>
                        <p class="fd-workflow__live-caption">{{ item.scene.caption }}</p>
                      </div>
                    </div>
                    {% elif item.scene and item.scene.type == "receipt" %}
                    <div class="fd-workflow__scene fd-workflow__scene--form{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__receipt">
                        <div class="fd-workflow__success fd-workflow__receipt-success">
                          <span class="fd-workflow__success-check" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                          <p class="fd-workflow__success-title">{{ item.scene.successTitle or item.title }}</p>
                          <span class="fd-workflow__phone-badge fd-workflow__phone-badge--completed">{{ item.scene.badge }}</span>
                        </div>
                        <div class="fd-workflow__receipt-card">
                          {% for r in item.scene.rows %}
                          <div class="fd-workflow__receipt-row"><span>{{ r[0] }}</span><span>{{ r[1] }}</span></div>
                          {% endfor %}
                          <div class="fd-workflow__receipt-row fd-workflow__receipt-row--total"><span>{{ item.scene.total[0] }}</span><span>{{ item.scene.total[1] }}</span></div>
                        </div>
                        <p class="fd-workflow__receipt-caption"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>{{ item.scene.caption }}</p>
                      </div>
                    </div>
                    {% elif item.scene and item.scene.type == "report" %}
                    <div class="fd-workflow__scene fd-workflow__scene--form{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__report">
                        <div class="fd-workflow__report-head">
                          <span class="fd-workflow__report-title">{{ item.scene.title }}</span>
                          <span class="fd-workflow__phone-badge fd-workflow__phone-badge--{{ item.scene.badgeClass or "completed" }}">{{ item.scene.badge }}</span>
                        </div>
                        <p class="fd-workflow__report-sub">{{ item.scene.sub }}</p>
                        <div class="fd-workflow__report-banner">
                          <span class="fd-workflow__form-banner-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                          {% for b in item.scene.banner %}
                          <div class="fd-workflow__report-banner-stat">
                            <span class="fd-workflow__report-banner-value">{{ b[0] }}</span>
                            <span class="fd-workflow__report-banner-label">{{ b[1] }}</span>
                          </div>
                          {% endfor %}
                        </div>
                        <span class="fd-workflow__review-label">{{ item.scene.insightsLabel }}</span>
                        <div class="fd-workflow__report-insights">
                          {% for i in item.scene.insights %}
                          <div class="fd-workflow__report-insight">
                            <span class="fd-workflow__review-icon"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
                            <span class="fd-workflow__report-insight-label">{{ i[0] }}</span>
                            <span class="fd-workflow__report-insight-value">{{ i[1] }}</span>
                          </div>
                          {% endfor %}
                        </div>
                        <p class="fd-workflow__dash-caption">{{ item.scene.caption }}</p>
                      </div>
                    </div>
                    {% elif isBookingCreate %}
                    <div class="fd-workflow__scene fd-workflow__scene--form{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__form">
                        <div class="fd-workflow__form-head">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                          <span>New booking</span>
                        </div>
                        <div class="fd-workflow__form-banner">
                          <span class="fd-workflow__form-banner-icon">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 2v4"/><path d="M8 2v4"/><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/></svg>
                          </span>
                          <div>
                            <p class="fd-workflow__form-banner-title">Sarah M. on the line</p>
                            <p class="fd-workflow__form-banner-sub">Book her in while she's still talking.</p>
                          </div>
                        </div>
                        <div class="fd-workflow__form-field">
                          <span class="fd-workflow__form-label">Service</span>
                          <div class="fd-workflow__form-select">
                            <span>Deep Tissue Massage</span>
                            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </div>
                        </div>
                        <div class="fd-workflow__form-field">
                          <span class="fd-workflow__form-label">Therapist</span>
                          <div class="fd-workflow__form-select">
                            <span>Emily C.</span>
                            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                          </div>
                        </div>
                        <div class="fd-workflow__form-row">
                          <div class="fd-workflow__form-field">
                            <span class="fd-workflow__form-label">Branch</span>
                            <div class="fd-workflow__form-select">
                              <span>Downtown</span>
                              <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                          </div>
                          <div class="fd-workflow__form-field">
                            <span class="fd-workflow__form-label">Time</span>
                            <div class="fd-workflow__form-select">
                              <span>11:00 AM</span>
                              <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </div>
                          </div>
                        </div>
                        <button class="fd-workflow__form-submit" type="button">
                          Confirm booking
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
                        </button>
                      </div>
                    </div>
                    {% elif isBookingConfirm %}
                    <div class="fd-workflow__scene fd-workflow__scene--form{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__review">
                        <div class="fd-workflow__notif fd-workflow__review-notif">
                          <div class="fd-workflow__notif-head">
                            <span class="fd-workflow__notif-logo">Z</span>
                            <span class="fd-workflow__notif-app">Zennly</span>
                            <span class="fd-workflow__notif-time fd-workflow__notif-time--plain">Just now</span>
                          </div>
                          <div class="fd-workflow__notif-body">
                            <strong>New booking · Sarah M. · 11:00 AM</strong>
                          </div>
                          <div class="fd-workflow__notif-foot">
                            <span class="fd-workflow__phone-badge fd-workflow__phone-badge--pending">Needs confirmation</span>
                          </div>
                        </div>

                        <span class="fd-workflow__review-label">Today's schedule</span>
                        <div class="fd-workflow__review-card">
                          <div class="fd-workflow__review-row">
                            <span class="fd-workflow__review-icon">
                              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            </span>
                            <div class="fd-workflow__review-field">
                              <span class="fd-workflow__review-field-label">11:00 AM · Deep Tissue · 60 min</span>
                              <span class="fd-workflow__review-field-value">Emily C. — Downtown</span>
                            </div>
                          </div>
                          <div class="fd-workflow__review-field fd-workflow__review-field--plain">
                            <span class="fd-workflow__review-field-label">Client</span>
                            <span class="fd-workflow__review-field-value">Sarah M.</span>
                          </div>
                        </div>

                        <button class="fd-workflow__form-submit" type="button">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          Confirm slot
                        </button>
                      </div>
                    </div>
                    {% elif isBookingLive %}
                    <div class="fd-workflow__scene{% if loop.first %} is-active{% endif %}">
                      <div class="fd-workflow__live">
                        <div class="fd-workflow__live-card">
                          <div class="fd-workflow__live-top">
                            <span class="fd-sch-dot pulsing"></span>
                            <span class="fd-workflow__live-label">Live now</span>
                            <span class="fd-workflow__notif-time">11:02 AM</span>

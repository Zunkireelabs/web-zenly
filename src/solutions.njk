{% from "schema/breadcrumb.njk" import breadcrumbSchema with context %}
{{ breadcrumbSchema([{ name: "Home", url: "/" }, { name: "Solutions", url: "/solutions/" }]) }}
{% from "schema/faq.njk" import faqSchema %}
{{ faqSchema(faq) }}

{#- Solutions index (2026-10-23): Square-style pinned video hero + collage (CLAUDE.md "Exception: Solutions Index
    Hero"), dark industry carousel, then the shared fd-page sheets. CSS: "SOLUTIONS INDEX" block at the end of main.css. -#}
<main class="fd-page fd-page--palette si-page">

  <!-- 1. Pinned hero: full-bleed video shrinks into a centre tile while the collage fades in, then the line lands -->
  <section class="si-scrolly" aria-label="Zennly for every kind of service business">
    <div class="si-sticky">
      <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="si-ink" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="7"/><feDisplacementMap in="SourceGraphic" scale="2.6"/></filter></svg>
      {%- asyncEach t in collage %}
      <div class="si-tile{% if t.ui %} si-tile--ui si-tile--{{ t.tint }}{% endif %}{% if t.doodle %} si-tile--doodle{% endif %}" style="--x:{{ t.x }}%; --y:{{ t.y }}%; --d:{{ t.d }}" aria-hidden="true">
        {%- if t.photo %}{% image t.photo, "", { loading: "lazy", sizes: "160px" } %}
        {%- elif t.doodle %}{% set d = t.doodle %}{% include "_si-doodle.njk" %}
        {%- else %}<div class="si-tile__ui">{{ t.ui | safe }}</div>{% endif -%}
      </div>
      {%- endeach %}
      <header class="si-vhero">
        <video autoplay muted loop playsinline preload="metadata" poster="/assets/images/hero-video-poster.jpg" aria-hidden="true"><source src="/assets/videos/hero-1280.mp4" type="video/mp4"></video>
        <div class="si-vhero__in">
          <h1>Built for the way <em>your business runs.</em></h1>
          <p class="si-vhero__sub">Spas, salons, studios and clinics: one system for bookings, payments, staff and every branch.</p>
          <div class="si-vbtns">
            <a href="#try-free" class="is-primary" data-trial-open>Try a free demo</a>
            <a href="/contact/" class="is-ghost">Talk to us</a>
          </div>
        </div>
        <nav class="si-quick" aria-label="Industries">
          {%- for it in industries %}<a href="/solutions/{{ it.slug }}/">{{ it.name }}</a>{% if not loop.last %}<i aria-hidden="true">·</i>{% endif %}{% endfor -%}
        </nav>
      </header>
      <h2 class="fd-h2 si-line">Whatever you run, <em>run it on one system.</em></h2>
    </div>
  </section>

  <!-- 2. Industries: dark band, homepage-style photo cards -->
  <section class="si-ind" id="types">
    <div class="fd-wrap si-ind__head reveal">
      <div>
        <h2 class="fd-h2">Made for <em>your kind of business.</em></h2>
        <p>Nine industries, each with its own page: a real day, real screens and the questions owners ask.</p>
      </div>
      <div class="si-ind__nav">
        <button type="button" class="si-ind__btn" data-si="-1" aria-label="Previous industry"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 5l-7 7 7 7"/></svg></button>
        <button type="button" class="si-ind__btn" data-si="1" aria-label="Next industry"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
      </div>
    </div>
    <div class="si-ind__scroller" data-lenis-prevent-horizontal>
      {%- asyncEach it in industries %}
      {%- asyncEach s in solutions %}{% if s.slug == it.slug %}
      <a href="/solutions/{{ it.slug }}/" class="si-card">
        <div class="si-card__photo">{% image s.hero.image, it.card, { loading: "lazy", sizes: "(max-width: 767px) 85vw, 340px", style: "object-position: center " ~ (s.sq.heroImageFocus or '50%') ~ ";" } %}</div>
        <div class="si-card__body"><span class="si-card__title">{{ it.card }}</span><span class="si-card__arrow" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span></div>
      </a>
      {%- endif %}{% endeach %}
      {%- endeach %}
    </div>
  </section>

  <!-- 3. Same core: tinted cards, each with a small live screen from the spa story -->
  <section class="fd-sheet fd-sheet--cream">
    <div class="fd-wrap">
      <div class="si-head reveal"><h2 class="fd-h2">Same core, <em>every business.</em></h2><p>Whatever you run, these six do the heavy lifting.</p></div>
      <div class="si-cores">
        {%- for c in core %}
        <a class="si-core si-core--{{ c.tint }} reveal" href="{{ c.href }}">
          <div class="si-core__stage"><div class="si-mini">{{ c.screen | safe }}</div></div>
          <h3>{{ c.title }}</h3>
          <p>{{ c.desc }}</p>
          <span class="si-core__link">{{ c.link }} →</span>
        </a>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- 4. Proof: real (Nuad Thai Spa, Zennly's first live client) -->
  <section class="fd-sheet fd-sheet--white">
    <div class="fd-wrap si-proof">
      <div class="reveal">
        <blockquote>“I used to spend my mornings calling every branch. Now I open the platform and everything is already there.”</blockquote>
        <p class="si-proof__cite">Owner · Nuad Thai Spa Kathmandu · 4 branches · <a href="/case-study/">Read the case study</a></p>
      </div>
      <div class="si-stats reveal">
        <div class="si-stat"><b>4</b><span>branches on one system</span></div>
        <div class="si-stat"><b>39</b><span>therapists scheduled</span></div>
        <div class="si-stat"><b>12</b><span>treatment rooms</span></div>
        <div class="si-stat"><b>194</b><span>services on the menu</span></div>
      </div>
    </div>
  </section>

  <!-- 5. FAQ (shared fd-faq) -->
  <section class="fd-sheet fd-sheet--cream fd-faq" id="faq">
    <div class="fd-wrap fd-faq__grid">
      <div class="fd-faq__head reveal">
        <h2 class="fd-h2">Questions, <em>answered.</em></h2>
      </div>
      <div class="fd-faq__list" x-data="{ open: null }">
        {% for item in faq %}
        <div class="fd-faq__item" :class="{ 'is-open': open === {{ loop.index0 }} }">
          <button class="fd-faq__q" @click="open = open === {{ loop.index0 }} ? null : {{ loop.index0 }}" :aria-expanded="open === {{ loop.index0 }}">
            <span>{{ item.question }}</span>
            <span class="fd-faq__icon" aria-hidden="true"></span>
          </button>
          <div class="fd-faq__a" x-show="open === {{ loop.index0 }}"  x-cloak>
            <p>{{ item.answer }}</p>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- 6. Final CTA (shared pink band, as on /about/) -->
  <section class="fd-sheet fd-band fd-final ab-final" id="demo">
    <div class="fd-wrap ab-final__in">
      <div>
        <h2 class="fd-h2">See Zennly with <em>your own services.</em></h2>
        <div class="fd-btns">
          <a href="#try-free" class="fd-btn fd-btn--white" data-trial-open>Try a free demo</a>
          <a href="/how-it-works/" class="fd-btn fd-btn--glass">See how it works</a>
        </div>
      </div>
      <div class="ab-final__phone"><div class="ab-phone">{% image "/assets/images/mobile-mockup.png", "Zennly calendar on a phone", { loading: "lazy" } %}</div></div>
    </div>
  </section>

  {% include "_footer-v2.njk" %}

  <script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cl = function (v) { return Math.max(0, Math.min(1, v)); };
    var ease = function (t) { return 1 - Math.pow(1 - t, 3); };
    var io = function (t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; };

    // Pinned hero: progress p (0→1) through .si-scrolly drives the clip/scale of the video, the tiles and the line.
    // Phones and reduced motion get the static layout from CSS (no pinning).
    var wrap = document.querySelector('.si-scrolly'), hero = wrap && wrap.querySelector('.si-vhero');
    if (hero) {
      var vid = hero.querySelector('video'), line = wrap.querySelector('.si-line');
      var tiles = [].slice.call(wrap.querySelectorAll('.si-tile'));
      var still = window.matchMedia('(max-width: 767px), (prefers-reduced-motion: reduce)');
      var frame = function () {
        if (still.matches) { ['--cx', '--cy', '--cr', '--ho'].forEach(function (k) { hero.style.removeProperty(k); }); hero.style.opacity = ''; vid.style.removeProperty('--vs'); vid.style.removeProperty('--vy'); return; }
        var r = wrap.getBoundingClientRect(), W = window.innerWidth, H = window.innerHeight;
        var p = cl(-r.top / (r.height - H)), tw = Math.min(340, W * .26), th = tw * 9 / 16, k = io(cl((p - .04) / .5));
        hero.style.setProperty('--cx', ((W - tw) / 2 * k).toFixed(1) + 'px');
        hero.style.setProperty('--cy', ((H - th) / 2 * k + H * .03 * k).toFixed(1) + 'px');
        hero.style.setProperty('--cr', (28 * Math.min(1, k * 5)).toFixed(1) + 'px');
        hero.style.setProperty('--ho', (1 - cl(p / .12)).toFixed(3));
        hero.style.opacity = (1 - cl((p - .72) / .12)).toFixed(3);
        vid.style.setProperty('--vs', (1 - (1 - Math.max(tw / W, th / H)) * k).toFixed(4));
        vid.style.setProperty('--vy', (H * .03 * k).toFixed(1) + 'px');
        tiles.forEach(function (t) { var d = +t.style.getPropertyValue('--d'); t.style.setProperty('--t', ease(cl((p - .24 - d * .05) / .28)).toFixed(3)); });
        line.style.setProperty('--l', ease(cl((p - .76) / .12)).toFixed(3));
      };
      var queued = false;
      var onScroll = function () { if (!queued) { queued = true; requestAnimationFrame(function () { queued = false; frame(); }); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      frame();
    }

    // Industry cards: arrows move one card; buttons disable at the ends.
    var sc = document.querySelector('.si-ind__scroller');
    if (sc) {
      var btns = document.querySelectorAll('.si-ind__btn');
      var pitch = function () { var c = sc.querySelectorAll('.si-card'); return c[1] ? c[1].offsetLeft - c[0].offsetLeft : sc.clientWidth; };
      var sync = function () { btns[0].disabled = sc.scrollLeft < 4; btns[1].disabled = sc.scrollLeft > sc.scrollWidth - sc.clientWidth - 4; };
      btns.forEach(function (b) { b.addEventListener('click', function () { sc.scrollBy({ left: +b.dataset.si * pitch(), behavior: reduce ? 'auto' : 'smooth' }); }); });
      sc.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }
  })();
  </script>

</main>

  {% include "_footer-v2.njk" %}

  <script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // evolution timeline arrows: one column per click; buttons disable at the ends
    var sc = document.querySelector('.ab-evo__scroller');
    if (!sc) return;
    var btns = document.querySelectorAll('.ab-evo__btn');
    var pitch = function () { var it = sc.querySelector('.ab-evo__item'); return it.getBoundingClientRect().width + parseFloat(getComputedStyle(sc.firstElementChild).columnGap || 0); };
    var sync = function () { btns[0].disabled = sc.scrollLeft < 4; btns[1].disabled = sc.scrollLeft > sc.scrollWidth - sc.clientWidth - 4; };
    btns.forEach(function (b) { b.addEventListener('click', function () { sc.scrollBy({ left: +b.dataset.evo * pitch(), behavior: reduce ? 'auto' : 'smooth' }); }); });
    sc.addEventListener('scroll', sync, { passive: true }); window.addEventListener('resize', sync); sync();
  })();
  </script>

</main>

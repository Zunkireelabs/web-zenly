    </div>
    {# PLACEHOLDER: month dates (Jan/Mar/Aug 2026) — replace with real ones #}
    {% set evo = [
      ["Today", "Open to businesses anywhere,", " on request, including the USA, UK, Canada, Australia and the UAE.", "/assets/images/solution-hero-fitness.png", "A fitness class in progress", ""],
      ["Aug 2026", "Six industries, one system.", " Spas, salons, tattoo studios, gyms, physiotherapy clinics and cleaning services.", "/assets/images/nuad/foot-lounge.jpg", "The foot spa lounge at Nuad Thai Spa", ""],
      ["Mar 2026", "Nuad Thai Spa Kathmandu goes live,", " our first client, running every branch on Zennly.", "/assets/images/nuad/gold-lounge.jpg", "A lounge at Nuad Thai Spa Kathmandu", ""],
      ["Jan 2026", "Zennly launches,", " putting booking, staff, discount approvals, payments and a locked daily close in one place.", "/assets/images/mobile-mockup.png", "The Zennly calendar on a phone", "ab-evo__media--ui"],
      ["2018", "Zunkireelabs is founded in Lalitpur,", " a software studio building products for businesses in Nepal.", "/assets/images/zunkireelabs-icon.png", "Zunkireelabs logo", "ab-evo__media--logo"]
    ] %}
    <div class="ab-evo__scroller" tabindex="0" aria-label="Zennly timeline">
      <ol class="ab-evo__track">

          <p class="ab-evo__text"><strong>{{ m[1] }}</strong>{{ m[2] }}</p>
          <div class="ab-evo__media {{ m[5] }}">{% image m[3], m[4], { loading: "eager" } %}</div>
        </li>
        {% endfor %}
      </ol>
    </div>
    <div class="fd-wrap ab-evo__nav">
      <button type="button" class="ab-evo__btn" data-evo="-1" aria-label="Earlier in the timeline"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
